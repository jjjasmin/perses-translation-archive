    },
    {
      "id": 8,
      "start": 50.76,
      "end": 58.52,
      "speaker": "",
      "text": "อ่อน[เพลง]ฉันรอเธอมาตลอดเธอก็มาเดี",
      "pronunciation_kana": "on・chan・ro・ter・maa・talot・ter・go・maa・dee",
