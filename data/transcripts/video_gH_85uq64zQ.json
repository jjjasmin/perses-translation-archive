    },
    {
      "id": 7,
      "start": 45.64,
      "end": 56.98,
      "speaker": "",
      "text": "นี้[เพลง]ก่อนมันคงไม่เป็นไรรักที่จะชี้",
      "pronunciation_kana": "nee・gon・man・khong・mai・pen・rai・rak・tee・ja・chee",
