  "members": [],
  "transcript": [
    {
      "id": 1,
      "start": 3,
      "end": 14,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 2,
      "start": 14,
      "end": 22,
      "speaker": "",
      "text": "รอยยิ้มของเธอช่างแสนงดงามแค่เพียงพริบตา ใครๆก็มองตามเปลี่ยนโลกทั้งใบจากวันมืด",
      "pronunciation_kana": "roy-yim-kong-ther-chang-saen-ngod-ngam-kae-piang-phrip-ta-krai-krai-go-mong-tam-plian-lok-tang-bai-jak-wan-muet",
      "pronunciation_roman": "roiyim khong thoe chang saen ngadangam khae phiang phripta khain k mongtam pelin lok thang bai chak wan muet",
      "translation": "君の笑顔は本当に美しくて一瞬で誰もが振り返り暗かった世界をすべて変えてしまう"
    },
    {
      "id": 3,
      "start": 22,
      "end": 29,
      "speaker": "",
      "text": "มิดเป็นสดใส แววตาแค่มองก็ทำให้ใจละลายแล้วหมุนอ่อน",
      "pronunciation_kana": "mit-pen-sod-sai-waeo-ta-kae-mong-go-tam-hai-jai-la-lai-laew-mun-on",
      "pronunciation_roman": "mit pen sadasai waeota khae mong k thamhai chai lalai laeo mun on",
      "translation": "明るくしてくれるんだ。その目を合わせるだけで胸がとろけて優しく巡っていくよ"
    },
    {
      "id": 4,
      "start": 29,
      "end": 36,
      "speaker": "",
      "text": "หวาน",
      "pronunciation_kana": "whan",
      "pronunciation_roman": "wan",
      "translation": "甘いね"
    },
    {
      "id": 5,
      "start": 36,
      "end": 45,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 6,
      "start": 45,
      "end": 76,
      "speaker": "",
      "text": "เธอเป็นบ้า หรือเปล่า",
      "pronunciation_kana": "ther-pen-ba-ru-plao",
      "pronunciation_roman": "thoe penba ruepela",
      "translation": "君はどうかしているんじゃない？"
    },
    {
      "id": 7,
      "start": 76,
      "end": 79,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 8,
      "start": 79,
      "end": 85,
      "speaker": "",
      "text": "เดี๋ยวใครมาหลงรักและ ฉัน",
      "pronunciation_kana": "diao-krai-ma-long-rak-lae-chan",
      "pronunciation_roman": "diao khain ma langrak lae chan",
      "translation": "もうすぐ誰かが君に夢中になってしまうよ、そして僕は"
    },
    {
      "id": 9,
      "start": 85,
      "end": 94,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 10,
      "start": 94,
      "end": 103,
      "speaker": "",
      "text": "ต้องทำยังไงกับความกังวลที่ฉันมีบางวันก็ เพ้อ ไม่อยากให้เธอยิ้มแต่โปรดอย่าส่งเวิ้งคง",
      "pronunciation_kana": "tong-tam-yang-ngai-gab-khwam-kang-won-ti-chan-mi-bang-wan-go-phoe-mai-yak-hai-ther-yim-tae-prot-ya-song-weng-khong",
      "pronunciation_roman": "tong tham yangngai kap khwamkanguan thi chan mi bang wan k phoe mai yak hai thoe yim tae pont ya song woeng khong",
      "translation": "僕が抱えるこの不安にどう対処すればいいんだろう、ある日はぼんやりして、君に笑ってほしくないなんて思ってしまうよ"
    },
    {
      "id": 11,
      "start": 103,
      "end": 116,
      "speaker": "",
      "text": "ทนไม่ไหวอ่ะคงทั้งโลกนั้นพากันชอบเธอ",
      "pronunciation_kana": "thon-mai-wai-a-khong-tang-lok-nan-pha-kan-chop-ther",
      "pronunciation_roman": "thanamaiwai a khong thanglok nan pha kan chop thoe",
      "translation": "我慢できないよ、きっと世界中の誰もが君を好きになってしまうから"
    },
    {
      "id": 12,
      "start": 116,
      "end": 124,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 13,
      "start": 124,
      "end": 133,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 14,
      "start": 133,
      "end": 138,
      "speaker": "",
      "text": "บ่อย",
      "pronunciation_kana": "boy",
      "pronunciation_roman": "boi",
      "translation": "しょっちゅうね"
    },
    {
      "id": 15,
      "start": 138,
      "end": 142,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 16,
      "start": 142,
      "end": 151,
      "speaker": "",
      "text": "หากเป็นแบบนี้ฉันไม่กล้า พอเจอใครมาลง",
      "pronunciation_kana": "hak-pen-baep-ni-chan-mai-kla-pho-chao-krai-ma-long",
      "pronunciation_roman": "ak pen baepni chan mai kla pho choe khain ma long",
      "translation": "こんな風になってしまったら、誰かがやってきても僕は勇気が出ないよ"
    },
    {
      "id": 17,
      "start": 151,
      "end": 153,
      "speaker": "",
      "text": "[ปรบมือ]",
      "pronunciation_kana": "prob-mue",
      "pronunciation_roman": "[ prabamue ]",
      "translation": "（拍手）"
    },
    {
      "id": 18,
      "start": 153,
      "end": 165,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 19,
      "start": 165,
      "end": 174,
      "speaker": "",
      "text": "อย่าเก็บเธอไว้ให้เป็นของฉันเท่านั้นไม่ อยากแต่งให้ใครไม่อยากแต่งให้ใคร",
      "pronunciation_kana": "ya-kep-ther-wai-hai-pen-kong-chan-tao-nan-mai-yak-taeng-hai-krai-mai-yak-taeng-hai-krai",
      "pronunciation_roman": "ya kep thoe wai hai pen khong chan thaonan mai yak taeng hai khain mai yak taeng hai khain",
      "translation": "君を僕だけのものにしておきたくない、誰にも着飾らせたくないんだ"
    },
    {
      "id": 20,
      "start": 174,
      "end": 176,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 21,
      "start": 176,
      "end": 182,
      "speaker": "",
      "text": "ไม่อยากต้องคิดถึงเธอบ่อยล่องลอยอยู่ใน",
      "pronunciation_kana": "mai-yak-tong-kit-thueng-ther-boy-long-loy-yut-nai",
      "pronunciation_roman": "mai yak tong khitthueng thoe boi longloi yu nai",
      "translation": "何度も君のことを考えて白昼夢に漂いたくないのに"
    },
    {
      "id": 22,
      "start": 182,
      "end": 197,
      "speaker": "",
      "text": "ฝันกลางวันโอ้เธอ",
      "pronunciation_kana": "fan-klang-wan-oh-ther",
      "pronunciation_roman": "fanklangwan o thoe",
      "translation": "ああ、君のことばかり考えてしまうよ"
    },
    {
      "id": 23,
      "start": 197,
      "end": 199,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 24,
      "start": 199,
      "end": 207,
      "speaker": "",
      "text": "ไม่อยากต้องคิดถึงเธอบ่อย",
      "pronunciation_kana": "mai-yak-tong-kit-thueng-ther-boy",
      "pronunciation_roman": "mai yak tong khitthueng thoe boi",
      "translation": "こんなに何度も君を恋しく思い出したりしたくないんだ"
    },
    {
      "id": 25,
      "start": 207,
      "end": 211,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 26,
      "start": 211,
      "end": 213,
      "speaker": "",
      "text": "หากเป็นแบบนี้",
      "pronunciation_kana": "hak-pen-baep-ni",
      "pronunciation_roman": "ak pen baepni",
      "translation": "もしこんな風になったら"
    },
    {
      "id": 27,
      "start": 213,
      "end": 213,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "pleng",
      "pronunciation_roman": "[ phenng ]",
      "translation": "（音楽）"
    },
    {
      "id": 28,
