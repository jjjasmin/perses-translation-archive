      "end": 7,
      "speaker": "",
      "text": "โอ Let's  go",
      "pronunciation_kana": "オー・レッツ・ゴー",
      "pronunciation_roman": "o Let 's go",
      "translations": {
        "ja": "オー、レッツ・ゴー！"
      }
    },
    {
      "id": 2,
      "start": 7,
      "end": 12,
      "speaker": "",
      "text": "[เพลง]",
      "pronunciation_kana": "プレーン",
      "pronunciation_roman": "[ phenng ]",
      "translations": {
