    {
      "id": 65,
      "start": 310.06,
      "end": 311.2,
      "text": "สดๆ ร้อนๆ"
    },
    {
      "id": 66,
      "start": 311.2,
      "end": 312.62,
      "text": "JUNG: ทำไมไม่มีเหงื่อเลยอะ / KRITTIN: เออทำไมปาล์มไม่มีเลยอะ"
    },
    {
      "id": 67,
      "start": 312.62,
      "end": 313.52,
      "text": "เช็ดไปแล้วไง"
