    {
      "id": 62,
      "start": 304.78,
      "end": 305.65,
      "text": "KRITTIN, PLUGGY: MU: CON"
    },
    {
      "id": 63,
      "start": 305.65,
      "end": 308.0,
      "text": "2023 แล้วนะครับ ที่เกาหลีนะครับผมทุกคน"
    },
    {
      "id": 64,
      "start": 308.0,
      "end": 310.06,
      "text": "เพิ่งลงมาเลย ดูจากเหงื่อพี่กฤต"
