    {
      "id": 56,
      "start": 226.61,
      "end": 231.15,
      "text": "ผมชื่อจั๋ง จาก PERSES นะครับ (My name is Jung from PERSES)"
    },
    {
      "id": 57,
      "start": 231.15,
      "end": 233.15,
      "text": "ผมกฤติน PERSES นะครับ"
    },
    {
      "id": 58,
      "start": 235.38,
      "end": 239.52,
      "text": "สวัสดีครับทุกคน ผมปลักกี้นะครับ มักเน่ของ PERSES ครับ"
    },
    {
      "id": 59,
      "start": 241.58,
      "end": 244.13,
      "text": "สวัสดีครับ ปาล์มนะครับ"
