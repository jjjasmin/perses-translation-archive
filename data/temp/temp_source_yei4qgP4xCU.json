  "transcript": [
    {
      "id": 1,
      "start": 0.04,
      "end": 13.52,
      "text": "ได้โปรดเลยอย่าฝืนเธอเราไปกันไม่ไหวให้"
    },
    {
      "id": 2,
      "start": 6.64,
      "end": 15.0,
      "text": "มันจบรงนี้คงดีกว่าต้องกลำกลืนใช่บถ้าหาก"
    },
    {
      "id": 3,
      "start": 13.52,
      "end": 21.64,
      "text": "เธอต้อง"
    },
    {
      "id": 4,
      "start": 15.0,
      "end": 28.16,
      "text": "ร้องปล่อยให้น้ำตาหลายไปไม่รู้ว่าจะฟืน"
    },
    {
      "id": 5,
      "start": 21.64,
      "end": 30.52,
      "text": "ทำไมเถอตอนสุดท้ายต้องไปดีสวัสดีครับทุก"
    },
    {
      "id": 6,
      "start": 28.16,
      "end": 34.72,
      "text": "คนในที่สุดวันนี้ก็มาถึงนะครับผมวันที่"
    },
    {
      "id": 7,
      "start": 30.52,
      "end": 37.44,
      "text": "พวกเราได้อัดเพลงใหม่ิลที่ 2 ต่อจากเพลง"
    },
    {
      "id": 8,
      "start": 34.72,
      "end": 39.08,
      "text": "บอดี้การดนะครับผมเพลงนี้มีชื่อว่าย่าฟืน"
    },
    {
      "id": 9,
      "start": 37.44,
      "end": 41.2,
      "text": "นะครับผมเรียกได้ว่าเป็นอีกสไตล์นึงที่"
    },
    {
      "id": 10,
      "start": 39.08,
      "end": 43.68,
      "text": "พวกเราเเซยังังไม่เคยลองทำกันมาครับผม"
    },
    {
      "id": 11,
      "start": 41.2,
      "end": 46.16,
      "text": "แล้วก็เป็นเพลงเศร้าที่คิดว่าลิงก์กับ"
    },
    {
      "id": 12,
      "start": 43.68,
      "end": 48.28,
      "text": "สถานการณ์ของใครหลายๆคนได้แน่นอนครับผมก็"
    },
    {
      "id": 13,
      "start": 46.16,
      "end": 50.08,
      "text": "อยากให้ทุกคนรอดูเบื้องหลังการถ่ายทำนะ"
    },
    {
      "id": 14,
      "start": 48.28,
      "end": 52.52,
      "text": "ครับผมว่าอัดเสียงเป็นยังไงกันบ้าง"
    },
    {
      "id": 15,
      "start": 50.08,
      "end": 55.52,
      "text": "บรรยากาศเป็นยังไงกันบ้างครับผมก็ไปดูกัน"
    },
    {
      "id": 16,
      "start": 52.52,
      "end": 55.52,
      "text": "เลย"
    },
    {
      "id": 17,
      "start": 65.24,
      "end": 72.68,
      "text": "มันกันน้าละนาที่เราคบกันแผนเรื่องดีดี"
    },
    {
      "id": 18,
      "start": 70.24,
      "end": 79.04,
      "text": "ตั้เป็นร้อย"
    },
    {
      "id": 19,
      "start": 72.68,
      "end": 83.68,
      "text": "แผนแต่ทำไมฉันไม่ซึ้งเลยโอเหมือนวันนี้"
    },
    {
      "id": 20,
      "start": 79.04,
      "end": 90.48,
      "text": "แววตาเธอฉันหวางเ่าตอนนี้เธอมองมาฉันรู้"
    },
    {
      "id": 21,
      "start": 83.68,
      "end": 93.04,
      "text": "สึกเหมือนจะขาดใจและในวันนี้ต้องพูดไปรู้"
    },
    {
      "id": 22,
      "start": 90.48,
      "end": 95.48,
      "text": "สึกว่าเพลงนี้มันเป็นเพลงที่ฟังง่ายขึ้น"
    },
    {
      "id": 23,
      "start": 93.04,
      "end": 97.96,
      "text": "แล้วก็เป็นเพลงที่ผมรู้สึกว่าผมฟิลกับ"
    },
    {
      "id": 24,
      "start": 95.48,
      "end": 100.08,
      "text": "เนื้อหามากๆเลยครับเนื้อเพลงเป็นแบบฟิวคน"
    },
    {
      "id": 25,
      "start": 97.96,
      "end": 102.28,
      "text": "แบบว่าเลิกกันอะไรเงี้ยแบบอย่าฝืนเลยถ้า"
    },
    {
      "id": 26,
      "start": 100.08,
      "end": 105.0,
      "text": "เราไปกันไม่ไหวอะไรเงี้ครับเลิกกันเถอะ"
    },
    {
      "id": 27,
      "start": 102.28,
      "end": 107.36,
      "text": "เป็นแบบผู้ชายคนนึงที่แบบยอมแพ้กับความ"
    },
    {
      "id": 28,
      "start": 105.0,
      "end": 109.76,
      "text": "รักหรือว่าแบบไปต่อความรักนี้ไม่ได้แล้ว"
    },
    {
      "id": 29,
      "start": 107.36,
      "end": 113.0,
      "text": "มันต้องจบลงอยู่ตรงนี้ครับแล้วก็เพลงนี้"
    },
    {
      "id": 30,
      "start": 109.76,
      "end": 115.52,
      "text": "จริงๆมันเป็นเพลงเศร้าเพลงแรกของเพรซเลย"
    },
    {
      "id": 31,
      "start": 113.0,
      "end": 117.84,
      "text": "คือปกติเราจะมีเพลงที่แบบเพลงช้าให้กำลัง"
    },
    {
      "id": 32,
      "start": 115.52,
      "end": 120.16,
      "text": "ใจอ่ะมีหมดแล้วแล้วก็เพลงคนใกล้ที่ฮิตไก"
    },
    {
      "id": 33,
      "start": 117.84,
      "end": 123.52,
      "text": "ก็จะเป็นเพลงเศร้าแต่เป็นเศร้าแบบแอบรัก"
    },
    {
      "id": 34,
      "start": 120.16,
      "end": 126.96,
      "text": "เฉยๆแต่ว่าพอเป็นเพลงนี้เนี่ยเป็นเพลงที่"
    },
    {
      "id": 35,
      "start": 123.52,
      "end": 129.96,
      "text": "เลิกลากันครั้งแรกเราอย่าฝืนเหอะแบบว่า"
    },
    {
      "id": 36,
      "start": 126.96,
      "end": 132.92,
      "text": "แยกย้ายกันไปอยู่ไปก็ไม่ได้มีอะไรดีขึ้น"
    },
    {
      "id": 37,
      "start": 129.96,
      "end": 135.16,
      "text": "เลยอย่างเงี้ยมันเศร้ามากตอนร้องเราก็แบบ"
    },
    {
      "id": 38,
      "start": 132.92,
      "end": 137.8,
      "text": "เราบิอารมณ์สุดใจเลยแบบอยากให้มันเศร้า"
    },
    {
      "id": 39,
      "start": 135.16,
      "end": 140.44,
      "text": "มากๆเพราะว่าเนื้อเพลงมันแบบถ้าใครฟังใคร"
    },
    {
      "id": 40,
      "start": 137.8,
      "end": 143.04,
      "text": "อกหักใครเศร้าอยู่อ่ะผมเชื่อว่าแบบร้อง"
    },
    {
      "id": 41,
      "start": 140.44,
      "end": 145.4,
      "text": "ไห้แน่ๆอย่าฝื้น่ะครับแบบอย่าฟื้นอะไร"
    },
    {
      "id": 42,
      "start": 143.04,
      "end": 150.8,
      "text": "อย่าเงี้ยรู้สึกว่าเพลงนี้ทุกคนนจะชอบนะ"
    },
    {
      "id": 43,
      "start": 145.4,
      "end": 152.28,
      "text": "ครับได้อย่าฝืนเ"
    },
    {
      "id": 44,
      "start": 150.8,
      "end": 157.04,
      "text": "ไปกันไม่"
    },
    {
      "id": 45,
      "start": 152.28,
      "end": 157.04,
      "text": "ไหวให้มันบรง"
    },
    {
      "id": 46,
      "start": 165.0,
      "end": 178.24,
      "text": "นี้ได้โปรดไลอย่าฝืนเถ้าเราไปกันไม่ไว้"
    },
    {
      "id": 47,
      "start": 172.32,
      "end": 181.2,
      "text": "ให้มันจบพรมนี้คงดีกว่าต้องกล่ำเกลืนใช่"
    },
    {
      "id": 48,
      "start": 178.24,
      "end": 184.2,
      "text": "ไหม"
    },
    {
      "id": 49,
      "start": 181.2,
      "end": 186.04,
      "text": "เออดีขึ้นนะดีขึ้นนะเริ่มเริ่มมั่นใจละ"
    },
    {
      "id": 50,
      "start": 184.2,
      "end": 190.48,
      "text": "เพื่อให้มันแบบว่าชัดขึ้นก็มันก็มีตรง"
    },
    {
      "id": 51,
      "start": 186.04,
      "end": 194.0,
      "text": "อย่าฝืนอันนึงใช่ป่ะอีกอันนึงถ้าเราไปกัน"
    },
    {
      "id": 52,
      "start": 190.48,
      "end": 198.96,
      "text": "ไม่ไวอันนี้มันต้องมีความสวัดแล้วก็แรง"
    },
    {
      "id": 53,
      "start": 194.0,
      "end": 201.52,
      "text": "ขึ้นหน่อยได้ไปกันไม่ไวเออใช่ได้ครับมัน"
    },
    {
      "id": 54,
      "start": 198.96,
      "end": 206.56,
      "text": "จะได้แบบพาไปอีกอ่ะเพราะประโยคเมันคือ"
    },
    {
      "id": 55,
      "start": 201.52,
      "end": 214.64,
      "text": "ประโยคประโยคจำอ่ะได้ครับลองดูได้โปรดเลย"
    },
    {
      "id": 56,
      "start": 206.56,
      "end": 219.24,
      "text": "อย่าฝืนเเราไปไม่ไวให้มันจบพวกนี้คงดี"
    },
    {
      "id": 57,
      "start": 214.64,
      "end": 223.8,
      "text": "กว่าต้องกลำคลืนใช่"
    },
    {
      "id": 58,
      "start": 219.24,
      "end": 226.52,
      "text": "ไหมอืๆๆดีเลยนะเนาพอพอไม่โฟกัสแล้วก็ดี"
    },
    {
      "id": 59,
      "start": 223.8,
      "end": 228.64,
      "text": "เออๆใช่อย่างงี้อย่างงี้จิตวิญญาณนี้มา"
    },
    {
      "id": 60,
      "start": 226.52,
      "end": 230.84,
      "text": "พี่มาครับด้วยความที่มันเป็นท่อนฮุกอะไร"
    },
    {
      "id": 61,
      "start": 228.64,
      "end": 232.76,
      "text": "เงี้ยเปิดฮุกมาเราต้องทำให้มันอพคใช่มย"
    },
    {
      "id": 62,
      "start": 230.84,
      "end": 237.28,
      "text": "แต่ว่าเหมือนคำว่าฝืนอ่ะเขาอยากให้ลองแบบ"
    },
    {
      "id": 63,
      "start": 232.76,
      "end": 239.36,
      "text": "ตรงเลยขึ้นแบบฟื้นอะไรเงี้ยแต่ผมร้องฟื้น"
    },
    {
      "id": 64,
      "start": 237.28,
      "end": 241.6,
      "text": "มันก็เลยแบบเฮ้ยมันไม่ใช่แนวของเราเราก็"
    },
    {
      "id": 65,
      "start": 239.36,
      "end": 243.44,
      "text": "เลยต้องปรับจูนนิดนึงอะไรเงี้ยแล้วก็"
    },
    {
      "id": 66,
      "start": 241.6,
      "end": 245.0,
      "text": "เหมือนมันต้องต่ออารมณ์ไปพี่เาบอกว่าเฮ้ย"
    },
    {
      "id": 67,
      "start": 243.44,
      "end": 248.24,
      "text": "เหมือนเราฝืนอยู่เลยอ่ะเออผมก็ฝืนอยู่"
    },
    {
      "id": 68,
      "start": 245.0,
      "end": 250.92,
      "text": "จริงๆนั่นแหละครับก็นิดนึงอแต่ว่าออกมาดี"
    },
    {
      "id": 69,
      "start": 248.24,
      "end": 257.84,
      "text": "ครับถ้าหากจะต้อง"
    },
    {
      "id": 70,
      "start": 250.92,
      "end": 264.28,
      "text": "ร้องปล่อยให้น้ำตาไหลไปไม่รู้ว่าจะฝืน"
    },
    {
      "id": 71,
      "start": 257.84,
      "end": 268.72,
      "text": "ทำไมธอตอนสุดท้ายต้องไปอยู่"
    },
    {
      "id": 72,
      "start": 264.28,
      "end": 274.16,
      "text": "ดีอืดีเลยครับอ่ะขอเลือกแป๊บนึง"
    },
    {
      "id": 73,
      "start": 268.72,
      "end": 281.72,
      "text": "ครับคิดเหมือนฉันใช่ไหมเพเรื่องเราคงไม่"
    },
    {
      "id": 74,
      "start": 274.16,
      "end": 281.72,
      "text": "ง่ายที่ผ่ามาเคยรักมากเท่าไรแต่ในตอนสุด"
    },
    {
      "id": 75,
      "start": 282.24,
      "end": 287.48,
      "text": "ท้ายอืข้างหน้าคดูดีเลยนะมันอาจจะมีแค่"
    },
    {
      "id": 76,
      "start": 285.76,
      "end": 290.32,
      "text": "ข้างหลังเพราะมันเป็นรีเนาะเราก็ส่งทำ"
    },
    {
      "id": 77,
      "start": 287.48,
      "end": 292.64,
      "text": "หน้าที่ส่งเข้าอีกสักนิดนึงเทนั้นนี้ครับ"
    },
    {
      "id": 78,
      "start": 290.32,
      "end": 295.08,
      "text": "อารมณ์ข้างหน้ากำลังกำลังดีแต่ว่าอาจจะ"
    },
    {
      "id": 79,
      "start": 292.64,
      "end": 298.4,
      "text": "พยายามทาให้มันลอยๆไว้ไหนก็ได้ได้ขนาดไน"
    },
    {
      "id": 80,
      "start": 295.08,
      "end": 300.72,
      "text": "มันหนักไปใช่มั้ยครับใช่ๆลอยๆไว้ช่วงแรกๆ"
    },
    {
      "id": 81,
      "start": 298.4,
      "end": 307.08,
      "text": "ค่อยๆพาหนักขึ้น"
    },
    {
      "id": 82,
      "start": 300.72,
      "end": 313.08,
      "text": "ได้ครับจะคิดเหมือนฉันใช่ไหมว่าเรื่องเรา"
    },
    {
      "id": 83,
      "start": 307.08,
      "end": 315.12,
      "text": "คงไม่ง่ที่พันมาเคยรักมากเท่าไหรแต่ในตอน"
    },
    {
      "id": 84,
      "start": 313.08,
      "end": 320.84,
      "text": "สุด"
    },
    {
      "id": 85,
      "start": 315.12,
      "end": 323.12,
      "text": "ท้ายได้โอ้ดีเลยนะงดงามอัดเมื่อกี้ก็รู้"
    },
    {
      "id": 86,
      "start": 320.84,
      "end": 326.04,
      "text": "สึกว่าเป็นแนวใหม่ดีด้วยความที่เราได้"
    },
    {
      "id": 87,
      "start": 323.12,
      "end": 327.84,
      "text": "ท่อนพรีฮกเงี้ยแล้วก็สไตล์การร้องมันจะ"
    },
    {
      "id": 88,
      "start": 326.04,
      "end": 330.84,
      "text": "เป็นแบบว่าเป็นเพลงที่ตรงไปตรงมาอะไร"
    },
    {
      "id": 89,
      "start": 327.84,
      "end": 333.04,
      "text": "เงี้ยก็จะแบบว่าค่อนข้างสื่อสแบบตรงไปตรง"
    },
    {
      "id": 90,
      "start": 330.84,
      "end": 340.68,
      "text": "มาเหมือนกันก็ต้องปรับการร้องประมาณนึง"
    },
    {
      "id": 91,
      "start": 333.04,
      "end": 343.44,
      "text": "ครับได้โปรดเลยอย่าฟืนเธอเราไปกันไม่"
    },
    {
      "id": 92,
      "start": 340.68,
      "end": 351.84,
      "text": "ไหวอือันนี้ก็ดี"
    },
    {
      "id": 93,
      "start": 343.44,
      "end": 353.4,
      "text": "นะไม่รู้ว่าจะฝันทำไมเธอตอนสุดท้ายต้องไป"
    },
    {
      "id": 94,
      "start": 351.84,
      "end": 358.24,
      "text": "อยู่"
    },
    {
      "id": 95,
      "start": 353.4,
      "end": 360.36,
      "text": "ดีอืดีเลยการร้องเพลงนี้กับแรปเพลงอื่น"
    },
    {
      "id": 96,
      "start": 358.24,
      "end": 363.0,
      "text": "ค่อนข้างต่างกันมากเพราะว่าปกติผมจะใช้"
    },
    {
      "id": 97,
      "start": 360.36,
      "end": 366.2,
      "text": "ช่องเสียงแบบแรปก็แรปเลยต่างกันร้องก็"
    },
    {
      "id": 98,
      "start": 363.0,
      "end": 368.44,
      "text": "ร้องเลยแต่ว่าคราวนี้คือลองเอามาผสมกันดู"
    },
    {
      "id": 99,
      "start": 366.2,
      "end": 370.6,
      "text": "แล้วก็แบบกลายเป็นร้องที่มีติด distortion"
    },
    {
      "id": 100,
      "start": 368.44,
      "end": 372.76,
      "text": "นิดนึงมันแบบเป็นกลิ่นเป็นคาแรคเตอร์เรา"
    },
    {
      "id": 101,
      "start": 370.6,
      "end": 377.36,
      "text": "อะไรอย่าเงี้ยค่อนข้างยากเพราะว่ามันแหด"
    },
    {
      "id": 102,
      "start": 372.76,
      "end": 382.52,
      "text": "มันเจ็บคอำหรับคววามเป็นจริงอไเมื่อฉันไป"
    },
    {
      "id": 103,
      "start": 377.36,
      "end": 385.68,
      "text": "พร้องไกับวันนี้คงดีกว่าทนจนตอนสุดท้ายค"
    },
    {
      "id": 104,
      "start": 382.52,
      "end": 390.28,
      "text": "ดีกว่าทนจนตอนสุดท้ายคงดีกว่าทนจนตอนสุด"
    },
    {
      "id": 105,
      "start": 385.68,
      "end": 394.92,
      "text": "ท้ายตอนสุดท้ายตอนสุดท้ายใช่ร้องไห้กับ"
    },
    {
      "id": 106,
      "start": 390.28,
      "end": 399.68,
      "text": "วันเนี้คงดีกว่าทนจะตอนสุดท้ายใช่ฉันหรือ"
    },
    {
      "id": 107,
      "start": 394.92,
      "end": 406.2,
      "text": "เปล่าเป็นฉันหรือเปล่าทำมเธอนั้นยใช่ฉัน"
    },
    {
      "id": 108,
      "start": 399.68,
      "end": 410.08,
      "text": "หรือเปล่าใช่หรือเปล่าคนๆนั้นใช่ฉันหรือ"
    },
    {
      "id": 109,
      "start": 406.2,
      "end": 411.84,
      "text": "เปล่าเฮ้ยพี่ปาลมเก่งมากเลยอันนี้ดีเลยนะ"
    },
    {
      "id": 110,
      "start": 410.08,
      "end": 414.64,
      "text": "มาครับ"
    },
    {
      "id": 111,
      "start": 411.84,
      "end": 417.68,
      "text": "Perfect บรรทัดที่ 2 มาแล้วก็ให้อชั่นมา"
    },
    {
      "id": 112,
      "start": 414.64,
      "end": 421.56,
      "text": "เพิ่มกับเบอร์ 6 เมื่อกี้หน่อยท่อนรู้สึก"
    },
    {
      "id": 113,
      "start": 417.68,
      "end": 425.84,
      "text": "ยากเหรอครับท่อนรวมครับที่แบบมันมีขึ้น"
    },
    {
      "id": 114,
      "start": 421.56,
      "end": 430.44,
      "text": "เสียงสูงด้วยอะไรอย่างี้บอกลจากนั้นก็"
    },
    {
      "id": 115,
      "start": 425.84,
      "end": 433.04,
      "text": "ทิ้งฉันไปแล้วก็เราต้องเกาะไปกับเพื่อนๆ"
    },
    {
      "id": 116,
      "start": 430.44,
      "end": 435.16,
      "text": "แบบเพราะมันรอง 5 คนมันก็เลยต้องแบบเกาะ"
    },
    {
      "id": 117,
      "start": 433.04,
      "end": 439.0,
      "text": "กับเพื่อนไปเรื่อยๆหรือว่าแบบจังหวะต้อง"
    },
    {
      "id": 118,
      "start": 435.16,
      "end": 441.56,
      "text": "เท่ากันอะไรอย่างเงี้ครับบอกแล้วจากนั้น"
    },
    {
      "id": 119,
      "start": 439.0,
      "end": 447.88,
      "text": "ก็ทิ้งฉัน"
    },
    {
      "id": 120,
      "start": 441.56,
      "end": 454.2,
      "text": "ไปจบแล้วฉากนี้ไม่เหลือค่า"
    },
    {
      "id": 121,
      "start": 447.88,
      "end": 459.6,
      "text": "ใดบออกลจากนั้นเแดนนี้"
    },
    {
      "id": 122,
      "start": 454.2,
      "end": 459.6,
      "text": "ไปจบแล้วความ"
    },
    {
      "id": 123,
      "start": 461.48,
      "end": 472.48,
      "text": "รักเอ้ยตอนท้ายออกดีมากอันนี้เธอหากเชอ"
    },
    {
      "id": 124,
      "start": 466.4,
      "end": 476.84,
      "text": "ต้องร้องก็ปล่อยให้น้ำตาไหล"
    },
    {
      "id": 125,
      "start": 472.48,
      "end": 480.2,
      "text": "ไปเฮ้ยอันนี้ดีทั้งก้อนเลยอ่ะเพลงอย่าฝืน"
    },
    {
      "id": 126,
      "start": 476.84,
      "end": 482.4,
      "text": "ได้พี่ตูนทีดานะครับผมมาแต่งเพลงให้นะ"
    },
    {
      "id": 127,
      "start": 480.2,
      "end": 485.2,
      "text": "ครับเอาจริงตอนแรกตื่นเต้นตื่นเต้นมากว่า"
    },
    {
      "id": 128,
      "start": 482.4,
      "end": 488.56,
      "text": "พอรู้ว่าพี่ตูนเป็นคนแต่งด้วยโอเป็น"
    },
    {
      "id": 129,
      "start": 485.2,
      "end": 491.48,
      "text": "เกียรตมากรู้สึกว่าเขาไกดร้องเราแบบได้"
    },
    {
      "id": 130,
      "start": 488.56,
      "end": 493.8,
      "text": "เห็นภาพว่าแบบเขาต้องการอะไรเแบบเออเคลาก"
    },
    {
      "id": 131,
      "start": 491.48,
      "end": 496.56,
      "text": "ไปถึงนี่นะแล้วหยุดนะบเขาต้องการแบบพให้"
    },
    {
      "id": 132,
      "start": 493.8,
      "end": 498.24,
      "text": "เขาชัดเจนก็รู้สึกว่าได้ประสบการณ์ใหม่ๆ"
    },
    {
      "id": 133,
      "start": 496.56,
      "end": 503.72,
      "text": "มาด้วย"
    },
    {
      "id": 134,
      "start": 498.24,
      "end": 504.96,
      "text": "ครับนานะที่เราคบกันาเรื่องดีดีมันเป็น"
    },
    {
      "id": 135,
      "start": 503.72,
      "end": 510.08,
      "text": "รอย"
    },
    {
      "id": 136,
      "start": 504.96,
      "end": 512.96,
      "text": "พันแต่ทำไมฉันไม่ซึงเลย"
    },
    {
      "id": 137,
      "start": 510.08,
      "end": 515.88,
      "text": "ตอนแรกที่พี่นตนะครับโทรมาหาผมบอกว่าเฮ้ย"
    },
    {
      "id": 138,
      "start": 512.96,
      "end": 518.44,
      "text": "แต่งเพลงให้เซสหน่อยครับผมก็ตื่นเต้นมาก"
    },
    {
      "id": 139,
      "start": 515.88,
      "end": 521.04,
      "text": "ครับเพราะว่าจริงๆติดตามผลงานน้องๆอยู่"
    },
    {
      "id": 140,
      "start": 518.44,
      "end": 523.6,
      "text": "แล้วครับแล้วก็รู้สึกว่าดีใจที่จะได้ทำ"
    },
    {
      "id": 141,
      "start": 521.04,
      "end": 525.88,
      "text": "เป็นเพลงอกหักให้ด้วยเพราะว่าเซเนี่ยที่"
    },
    {
      "id": 142,
      "start": 523.6,
      "end": 528.16,
      "text": "ผมฟังเนี่ยจะเป็นเพลงแบบออกแนวแบบน่ารักๆ"
    },
    {
      "id": 143,
      "start": 525.88,
      "end": 530.92,
      "text": "รหน่อยยังไม่มีเพลงที่แบบซีเรียสถึงขั้น"
    },
    {
      "id": 144,
      "start": 528.16,
      "end": 534.24,
      "text": "แบบว่าเพลงเนี้ยที่ผมแต่งมีความแบบดราม่า"
    },
    {
      "id": 145,
      "start": 530.92,
      "end": 536.96,
      "text": "ขึ้นมามีความพุ่งของดนตรีขึ้นมาให้ครับก็"
    },
    {
      "id": 146,
      "start": 534.24,
      "end": 539.16,
      "text": "ได้เป็นไอเดียว่าแบบเฮ้ยถ้าเราไปกันไม่"
    },
    {
      "id": 147,
      "start": 536.96,
      "end": 541.64,
      "text": "ไหวเนี่ยก็ไม่ต้องฝืนดียอะไรเงี้ยก็จะอั"
    },
    {
      "id": 148,
      "start": 539.16,
      "end": 544.08,
      "text": "เลวเลลความดราม่าขึ้นมานะครับอาจจะแบบ"
    },
    {
      "id": 149,
      "start": 541.64,
      "end": 546.88,
      "text": "เป็นมิติใหม่ๆให้น้องๆครับผมก็ยังไงนะ"
    },
    {
      "id": 150,
      "start": 544.08,
      "end": 551.28,
      "text": "ครับฝากเพลงยาฟืนนะครับที่ผมแต่งให้เพซ"
    },
    {
      "id": 151,
      "start": 546.88,
      "end": 554.64,
      "text": "ด้วยนะครับมันก็นวละนาที่เราคบกันแผ่าน"
    },
    {
      "id": 152,
      "start": 551.28,
      "end": 559.6,
      "text": "เรื่องดีๆต้องเป็นร"
    },
    {
      "id": 153,
      "start": 554.64,
      "end": 563.96,
      "text": "พันแต่ทำไมฉันไม่ซึงเลย"
    },
    {
      "id": 154,
      "start": 559.6,
      "end": 568.04,
      "text": "ออกวอก็ดีขึ้นนะแต่ว่ามาได้อีกนะได้ครับ"
    },
    {
      "id": 155,
      "start": 563.96,
      "end": 572.72,
      "text": "มันกันนานแล้วนะว่าคือคเยมันกนมันกันนา"
    },
    {
      "id": 156,
      "start": 568.04,
      "end": 578.16,
      "text": "แล้วนะมันนนะที่เราคบกันเอ้ออะไรอย่าง"
    },
    {
      "id": 157,
      "start": 572.72,
      "end": 583.0,
      "text": "เงี้ยแบบจังหวะจักโคนขึ้นนิดนึงรอครับมัน"
    },
    {
      "id": 158,
      "start": 578.16,
      "end": 590.36,
      "text": "คือแนวหนาที่เราคบกันผ่านเรื่องไม่ดีต"
    },
    {
      "id": 159,
      "start": 583.0,
      "end": 594.72,
      "text": "เป็นร้อยพันแต่ทำให้ฉันไม่ซึ้เลยอรอ"
    },
    {
      "id": 160,
      "start": 590.36,
      "end": 597.0,
      "text": "เหมือนวันไม่แวแบบนี้เลยแบบนี้เลยชอบๆๆอ"
    },
    {
      "id": 161,
      "start": 594.72,
      "end": 599.36,
      "text": "ทรงนี้ถูกต้องรอบนี้ผมได้ร้องเป็นแบบเป็น"
    },
    {
      "id": 162,
      "start": 597.0,
      "end": 601.48,
      "text": "คนร้องเปิดเราต้องสามารถสื่อสารอารมณ์ได้"
    },
    {
      "id": 163,
      "start": 599.36,
      "end": 603.88,
      "text": "ตั้งแต่คำแรกเพราะว่าผมเคยเรียนร้องเพลง"
    },
    {
      "id": 164,
      "start": 601.48,
      "end": 606.24,
      "text": "กับครูท่านนึงมาแล้วเขาบอกว่าถ้าสมมติว่า"
    },
    {
      "id": 165,
      "start": 603.88,
      "end": 608.56,
      "text": "เพลงนั้นน่ะคนจะฟังต่อหรือไม่ฟังต่ออาจจะ"
    },
    {
      "id": 166,
      "start": 606.24,
      "end": 611.0,
      "text": "ขึ้นอยู่ที่ท่อนแรกของเพลงนั้นด้วยว่ามัน"
    },
    {
      "id": 167,
      "start": 608.56,
      "end": 616.12,
      "text": "จะสามารถแบบแช Attention ของคนได้หรือ"
    },
    {
      "id": 168,
      "start": 611.0,
      "end": 623.08,
      "text": "เปล่าอะไรอย่าเงี้ยได้โปรดอย่าฝืนเธอไป"
    },
    {
      "id": 169,
      "start": 616.12,
      "end": 625.24,
      "text": "กันไม่ไหวให้มันจบตรงนี้คงดีพิอดีแล้วแต่"
    },
    {
      "id": 170,
      "start": 623.08,
      "end": 629.44,
      "text": "เหลือแค่ไอคำว่า"
    },
    {
      "id": 171,
      "start": 625.24,
      "end": 637.0,
      "text": "เคำว่าเรามันขาดไปเมื่อกี้"
    },
    {
      "id": 172,
      "start": 629.44,
      "end": 644.36,
      "text": "เธอเราเถอเราไปกันไม่ไว้ต่อเลยเธอเราไปนะ"
    },
    {
      "id": 173,
      "start": 637.0,
      "end": 650.68,
      "text": "ครับรอนะครับบอกลาจากนั้นก็ถิงฉัน"
    },
    {
      "id": 174,
      "start": 644.36,
      "end": 657.04,
      "text": "ไปจกแล้วจากนี้ไม่เหลือค่า"
    },
    {
      "id": 175,
      "start": 650.68,
      "end": 659.84,
      "text": "ใดบอกลจากนั้นก็เดินนี้"
    },
    {
      "id": 176,
      "start": 657.04,
      "end": 662.48,
      "text": "ไปจบแล้ว"
    },
    {
      "id": 177,
      "start": 659.84,
      "end": 662.48,
      "text": "ความ"
    },
    {
      "id": 178,
      "start": 663.68,
      "end": 670.76,
      "text": "รักถ้าเราจะฟืนก็เพียง A  Little  Bit"
    },
    {
      "id": 179,
      "start": 667.28,
      "end": 674.2,
      "text": "long มันคงจะเสียเวลาฉันคิดว่าเราต้องพอ"
    },
    {
      "id": 180,
      "start": 670.76,
      "end": 678.96,
      "text": "เธอรความจริงอ่าดีขึ้นนะทีนี้เหลือแค่คำ"
    },
    {
      "id": 181,
      "start": 674.2,
      "end": 682.68,
      "text": "ว่าเพียง little  bit เพ A  Little  Bit"
    },
    {
      "id": 182,
      "start": 678.96,
      "end": 687.16,
      "text": "little  bit  little  bit  little  bit"
    },
    {
      "id": 183,
      "start": 682.68,
      "end": 691.24,
      "text": "little  bit เออใช่ Little  longer ใส่"
    },
    {
      "id": 184,
      "start": 687.16,
      "end": 691.24,
      "text": "สำเนียงแก En ขึนมาหน่อย"
    },
    {
      "id": 185,
      "start": 692.56,
      "end": 696.28,
      "text": "Little"
    },
    {
      "id": 186,
      "start": 694.48,
      "end": 700.32,
      "text": "Little"
    },
    {
      "id": 187,
      "start": 696.28,
      "end": 704.28,
      "text": "Little  Little  Bit  Little  B  little"
    },
    {
      "id": 188,
      "start": 700.32,
      "end": 707.96,
      "text": "bit  little  bit  longer"
    },
    {
      "id": 189,
      "start": 704.28,
      "end": 712.96,
      "text": "ใช่ฟืนเพียง A  Little  Bit  longer มัน"
    },
    {
      "id": 190,
      "start": 707.96,
      "end": 717.08,
      "text": "คงจะเสียเวลาฉันคิดว่าเราต้องพอเธอคามอ้า"
    },
    {
      "id": 191,
      "start": 712.96,
      "end": 720.2,
      "text": "ดีเลยถ้าเราจะฟืนเพียง A  Little  Bit"
    },
    {
      "id": 192,
      "start": 717.08,
      "end": 726.32,
      "text": "longer มันคงจะเสียเวลาฉันคิดว่าเราต้อง"
    },
    {
      "id": 193,
      "start": 720.2,
      "end": 734.72,
      "text": "พอเธอสำหรับความไม่จริงเออดีไม่รู้ว่าจะ"
    },
    {
      "id": 194,
      "start": 726.32,
      "end": 738.32,
      "text": "ฝืนทำไมถ้าตอนสุดท้ายต้องไปอยู่ดีเค้พี่"
    },
    {
      "id": 195,
      "start": 734.72,
      "end": 740.8,
      "text": "เนเรียบรอยโอเคครับขอบคุณครับขอบคุณครับ"
    },
    {
      "id": 196,
      "start": 738.32,
      "end": 743.2,
      "text": "รู้สึกว่าแรปเพลงนี้อาจจะแบบไม่ได้เดือด"
    },
    {
      "id": 197,
      "start": 740.8,
      "end": 746.2,
