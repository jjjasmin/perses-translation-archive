    },
    {
      "id": 255,
      "start": 878.21,
      "end": 879.97,
      "text": "KRITTIN: แล้วก็ หวาน มัน กลมกล่อมทุกคน"
    },
    {
      "id": 256,
      "start": 882.27,
      "end": 882.77,
      "text": "KRITTIN: อร่อยมากเลยครับ"
    },
