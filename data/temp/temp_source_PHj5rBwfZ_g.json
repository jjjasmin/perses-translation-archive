    },
    {
      "id": 246,
      "start": 844.18,
      "end": 844.68,
      "text": "ALIZABETH: ขอบคุณค่ะ"
    },
    {
      "id": 247,
      "start": 854.0,
      "end": 856.52,
      "text": "KRITTIN: ตอนนี้เราก็อยู่ที่ Shilin Night Market นะครับ/ ตลาดกลางคืนซื่อหลิน"
    },
