      "start": 274.52,
      "end": 278.56,
      "text": "เออโอเคชอบซีนที่มันมีแบบเอฟเฟคออกมาจาก"
    },
    {
      "id": 130,
      "start": 277.12,
      "end": 280.96,
      "text": "ร่างของทุกคนน่ะแบบ"
    },
    {
      "id": 131,
      "start": 278.56,
      "end": 284.4,
      "text": "เวลาทุกคนเล่นอะไรใช้ปลาวิ่งก็จะมีของผม"
    },
    {
      "id": 132,
      "start": 280.96,
      "end": 286.56,
      "text": "ก็จะมีปักี้ก็จะมีไฟแบบอะไรพี่จัก็จะมี"
    },
    {
      "id": 133,
      "start": 284.4,
      "end": 287.84,
      "text": "ชอบตอนที่มันโดนหน้ามันดูแบบมันดูเหมือน"
    },
    {
      "id": 134,
      "start": 286.56,
      "end": 288.52,
      "text": "โดนจริงอ่ะแต่มันโดนไม่จริงป่ะ"
    },
    {
      "id": 135,
      "start": 287.84,
      "end": 290.2,
      "text": "อ๋อไม่จริง"
    },
    {
      "id": 136,
      "start": 288.52,
      "end": 291.48,
      "text": "เออมันดูเหมือนโดนจริงแต่แบบแต่หลุดแต่"
    },
    {
      "id": 137,
      "start": 290.2,
      "end": 292.48,
      "text": "หน้าอร่อยป่ะตนี้"
    },
    {
      "id": 138,
      "start": 291.48,
      "end": 295.44,
      "text": "เออนั่น"
    },
    {
      "id": 139,
      "start": 292.48,
      "end": 296.2,
      "text": "เบอะน่าอยู่เออชอบๆ"
    },
    {
      "id": 140,
      "start": 295.44,
      "end": 298.16,
      "text": "แล้วปามล่ะฮะ"
    },
    {
      "id": 141,
      "start": 296.2,
      "end": 299.4,
      "text": "ชอบซีนโคอัของแต่ละคน"
    },
    {
      "id": 142,
      "start": 298.16,
      "end": 302.28,
      "text": "เออ"
    },
    {
      "id": 143,
      "start": 299.4,
      "end": 303.16,
      "text": "รู้สึกว่า MV นี้ทุกคนหล่อดีเออ"
    },
    {
      "id": 144,
      "start": 302.28,
      "end": 305.52,
      "text": "เออ"
    },
    {
      "id": 145,
      "start": 303.16,
      "end": 306.28,
      "text": "หล่อแบบหล่อคีนๆอ่ะหล่อคีนๆ"
    },
    {
      "id": 146,
      "start": 305.52,
      "end": 308.56,
      "text": "เออ"
    },
    {
      "id": 147,
      "start": 306.28,
      "end": 310.96,
      "text": "ปกติเราจะแบบปกติเราจะแบบดุๆไงแบบ"
    },
    {
      "id": 148,
      "start": 308.56,
      "end": 313.24,
      "text": "อ๋อดุๆโอเคอันนี้เป็นชุดกีฬาไม่โป๊เลย"
    },
    {
      "id": 149,
      "start": 310.96,
      "end": 314.36,
      "text": "เออมันขีดๆไงรอแบบเทศอย่างเงี้"
    },
    {
      "id": 150,
      "start": 313.24,
      "end": 315.36,
      "text": "หล่อ"
    },
    {
      "id": 151,
      "start": 314.36,
      "end": 317.76,
      "text": "เออไม่หล่อเหรอ"
    },
    {
      "id": 152,
      "start": 315.36,
      "end": 320.32,
      "text": "หล่อยิ่งคุณหล่อไง"
    },
    {
      "id": 153,
      "start": 317.76,
      "end": 322.12,
      "text": "อันนี้คุณหล่อคุณหล่อขึ้นเยอะป้า"
    },
    {
      "id": 154,
      "start": 320.32,
      "end": 323.16,
      "text": "ออบนุ[เสียงหัวเราะ]"
    },
    {
      "id": 155,
      "start": 322.12,
      "end": 326.85,
      "text": "อ่ะบากี้บี้"
    },
    {
      "id": 156,
      "start": 323.16,
      "end": 327.36,
      "text": "ผมชอบเต้นแล้วกันดูเต้นแพงกันมาก"
    },
    {
      "id": 157,
      "start": 326.85,
      "end": 329.24,
      "text": "[เสียงหัวเราะ]"
    },
    {
      "id": 158,
      "start": 327.36,
      "end": 331.24,
      "text": "ดูไม่แย่เลยจริง"
    },
    {
      "id": 159,
      "start": 329.24,
      "end": 332.8,
      "text": "ไม่คือต้องบอกว่าเพลงนี้เรามีเวลาซ้อม"
    },
    {
      "id": 160,
      "start": 331.24,
      "end": 335.04,
      "text": "น้อยมากๆน้อยมากที่สุด"
    },
    {
      "id": 161,
      "start": 332.8,
      "end": 336.12,
      "text": "คือตอนที่จะถ่ายอยู่ก็ยังซ้อมได้ไม่จบ"
    },
    {
      "id": 162,
      "start": 335.04,
      "end": 338.4,
      "text": "เพลงเลยนะครับตอน"
    },
    {
      "id": 163,
      "start": 336.12,
      "end": 338.72,
      "text": "ใช่คือเราต่อท่าเมื่อวานแล้วก็ถ่ายพวกนี้"
    },
    {
      "id": 164,
      "start": 338.4,
      "end": 339.0,
      "text": "เลย"
    },
    {
      "id": 165,
      "start": 338.72,
      "end": 340.52,
      "text": "ใช่"
    },
    {
      "id": 166,
      "start": 339.0,
      "end": 341.6,
      "text": "ใช่"
    },
    {
      "id": 167,
      "start": 340.52,
      "end": 344.04,
      "text": "พูดอวดไว้ก่อน"
    },
    {
      "id": 168,
      "start": 341.6,
      "end": 346.56,
      "text": "เออๆตอนแรกอ่ะพวกเราแบบแอมไม่ค่อยชินกับ"
    },
    {
      "id": 169,
      "start": 344.04,
      "end": 348.6,
      "text": "ท่าเต้นเหมือนเราอยู่กับแบบฟรีซอยู่กับ"
    },
    {
      "id": 170,
      "start": 346.56,
      "end": 350.44,
      "text": "เทิร์นมานานอะไรอย่างเงี้ยแล้วพอเรากลับ"
    },
    {
      "id": 171,
      "start": 348.6,
      "end": 352.12,
      "text": "มาเต้นเราแบบหื"
    },
    {
      "id": 172,
      "start": 350.44,
      "end": 354.92,
      "text": "อันนี้มันมีความแบบ"
    },
    {
      "id": 173,
      "start": 352.12,
      "end": 357.04,
      "text": "เออมันมีความแบบกลับมาเป็นกลับมาเป็นเด็ก"
    },
    {
      "id": 174,
      "start": 354.92,
      "end": 358.16,
      "text": "ผู้ชายอีกครั้งนึงอะไร"
    },
    {
      "id": 175,
      "start": 357.04,
      "end": 359.92,
      "text": "ตอนนี้ไม่ใช่เด็กผู้ชายเนาะ"
    },
    {
      "id": 176,
      "start": 358.16,
      "end": 362.0,
      "text": "ไม่หมายถึงว่าอันก่อนหน้านี้มันจะเป็นบ"
    },
    {
      "id": 177,
      "start": 359.92,
      "end": 364.24,
      "text": "ผู้ชายโตเปรี้ยวใช่เป"
    },
    {
      "id": 178,
      "start": 362.0,
      "end": 367.08,
      "text": "ใช่จริงที่แล้วเราบอกว่านี่ทุกคนดูโตขึ้น"
    },
    {
      "id": 179,
      "start": 364.24,
      "end": 368.16,
      "text": "เยอะตอนนี้ทุกคนดูเด็กลงเยอะเฮ้ยกลับมา"
    },
    {
      "id": 180,
      "start": 367.08,
      "end": 372.16,
      "text": "อีกรอบนึงจ"
    },
    {
      "id": 181,
      "start": 368.16,
      "end": 373.4,
      "text": "ผมชอบซีนชอบซีนที่ปักกี้ลงไปนอนแล้วก็แพ้"
    },
    {
      "id": 182,
      "start": 372.16,
      "end": 374.2,
      "text": "แล้วแหละแต่เชิด[เสียงหัวเราะ]"
    },
    {
      "id": 183,
      "start": 373.4,
      "end": 375.52,
      "text": "เออ"
    },
    {
      "id": 184,
      "start": 374.2,
      "end": 376.52,
      "text": "ก็ยังเป็นปักกี้อยู่"
    },
    {
      "id": 185,
      "start": 375.52,
      "end": 378.2,
      "text": "ใช่เชิด"
    },
    {
      "id": 186,
      "start": 376.52,
      "end": 380.76,
      "text": "ผมชอบซีบับตัวเองมากนะแบบ"
    },
    {
      "id": 187,
      "start": 378.2,
      "end": 382.04,
      "text": "เฮ้ยโดอ้าหน้ามันอยู่ไงเฮ้ยเพราะแกชอบไง"
    },
    {
      "id": 188,
      "start": 380.76,
      "end": 383.2,
      "text": "เฮ้ยแล้วชุดแกก็"
    },
    {
      "id": 189,
      "start": 382.04,
      "end": 385.44,
      "text": "ชอบหน้าแล้ว"
    },
    {
      "id": 190,
      "start": 383.2,
      "end": 386.08,
      "text": "ชุดแกเป็นชุดคนเดียวที่ชุดโซะนะ"
    },
    {
      "id": 191,
      "start": 385.44,
      "end": 388.16,
      "text": "เออ"
    },
    {
      "id": 192,
      "start": 386.08,
      "end": 390.44,
      "text": "เไม่เอวเอวขึ้นมาเปิ้งลังเออ"
    },
    {
      "id": 193,
      "start": 388.16,
      "end": 392.96,
      "text": "เป็นนักฟันดาบไงนาฮีโดไง"
    },
    {
      "id": 194,
      "start": 390.44,
      "end": 395.64,
      "text": "คือของเราต้องมีแบบว่าคู่แข่งของแต่ละคน"
    },
    {
      "id": 195,
      "start": 392.96,
      "end": 398.0,
      "text": "แบบว่ามาแข่งกีฬากันซึ่งของผมก็เป็นพี่"
    },
    {
      "id": 196,
      "start": 395.64,
      "end": 399.16,
      "text": "เซ็นครับผมซึ่งพี่เซ็นเนี่ยเขาแบบแข่ง"
    },
    {
      "id": 197,
      "start": 398.0,
      "end": 399.52,
      "text": "ไฮลอกอยู่แล้ว"
    },
    {
      "id": 198,
      "start": 399.16,
      "end": 401.52,
      "text": "เออ"
    },
    {
      "id": 199,
      "start": 399.52,
      "end": 401.96,
      "text": "เออซึ่งบอกได้เลยว่า"
    },
    {
      "id": 200,
      "start": 401.52,
      "end": 403.52,
      "text": "แน่น"
    },
    {
      "id": 201,
      "start": 401.96,
      "end": 407.36,
      "text": "สู้ไม่ไหวจริงๆ"
    },
    {
      "id": 202,
      "start": 403.52,
      "end": 408.92,
      "text": "ที่ให้เขาลากก็คือลากจริงลากแบบลากจริง"
    },
    {
      "id": 203,
      "start": 407.36,
      "end": 409.36,
      "text": "เออก็แบบสนุก"
    },
    {
      "id": 204,
      "start": 408.92,
      "end": 410.52,
      "text": "สนุกครับ"
    },
    {
      "id": 205,
      "start": 409.36,
      "end": 411.6,
      "text": "สนุกๆ"
    },
    {
      "id": 206,
      "start": 410.52,
      "end": 414.28,
      "text": "เพราะผมก็เป็นพี่ิงปอง"
    },
    {
      "id": 207,
      "start": 411.6,
      "end": 416.92,
      "text": "มันทำให้ดู MV ดูมีสีสันดีมันดูแบบมันดู"
    },
    {
      "id": 208,
      "start": 414.28,
      "end": 419.6,
      "text": "ตัดเลี่ยนเ้าเข้ามาแบบว่าทำให้ MV ดูไม่"
    },
    {
      "id": 209,
      "start": 416.92,
      "end": 421.16,
      "text": "จริงจังเกินไปดูแบบดูเพลินอ่ะดู"
    },
    {
      "id": 210,
      "start": 419.6,
      "end": 423.28,
      "text": "เปิดมาคนแรกเลยอ่ะต่อจากปี"
    },
    {
      "id": 211,
      "start": 421.16,
      "end": 424.44,
      "text": "ใช่แล้วมันรู้สึกว่าเอ้ยอันนี้คือมันคือ"
    },
    {
      "id": 212,
      "start": 423.28,
      "end": 424.64,
      "text": "ภาพใหม่ของเบอร์เซนะครับ"
    },
    {
      "id": 213,
      "start": 424.44,
      "end": 428.96,
      "text": "ใช่"
    },
    {
      "id": 214,
      "start": 424.64,
      "end": 431.56,
      "text": "ตัวแรงทั้งคู่ผมกีฬาวิ่งมีพี่สีเเป็นนัก"
    },
    {
      "id": 215,
      "start": 428.96,
      "end": 433.8,
      "text": "วิ่งอยู่แล้ว"
    },
    {
      "id": 216,
      "start": 431.56,
      "end": 434.88,
      "text": "เเป็นคลับรัน"
    },
    {
      "id": 217,
      "start": 433.8,
      "end": 435.96,
      "text": "สบายรันขับ"
    },
    {
      "id": 218,
      "start": 434.88,
      "end": 439.36,
      "text": "ใช่สบายขับ"
    },
    {
      "id": 219,
      "start": 435.96,
      "end": 441.12,
      "text": "บอกเลยว่าวันนั้นซินปมทุกคนกีกันหมด"
    },
    {
      "id": 220,
      "start": 439.36,
      "end": 442.6,
      "text": "เพราะว่าอีปามวิ่งฝั่งวิ่งไปเรื่อยไป"
    },
    {
      "id": 221,
      "start": 441.12,
      "end": 443.96,
      "text": "เรื่อยไปเรื่อยอะไรก็ไม่รู้แต่ว่าไม่เป็น"
    },
    {
      "id": 222,
      "start": 442.6,
      "end": 446.6,
      "text": "ไรน้องปาล์มก็แพ้นะครับ"
    },
    {
      "id": 223,
      "start": 443.96,
      "end": 450.0,
      "text": "เอ้ยน้องปาเออน้องปก็แพ้แพ้แพ้ทุกคนอยู่"
    },
    {
      "id": 224,
      "start": 446.6,
      "end": 453.24,
      "text": "แล้วใช่ๆผมเป็นน้องคริสอารา่าครับ"
    },
    {
      "id": 225,
      "start": 450.0,
      "end": 457.4,
      "text": "เป็นแบบว่าเจ้าหญิงส่งตัวมาจากวังเออ"
    },
    {
      "id": 226,
      "start": 453.24,
      "end": 459.64,
      "text": "จีเนี่ยเคยมีเรียนฟันดาบมาบ้างผมก็ถามจาก"
    },
    {
      "id": 227,
      "start": 457.4,
      "end": 460.4,
      "text": "คริสนั่นแหละว่าเอ้ยคริสทำไงวะพี่คงทำไง"
    },
    {
      "id": 228,
      "start": 459.64,
      "end": 461.92,
      "text": "วะ"
    },
    {
      "id": 229,
      "start": 460.4,
      "end": 464.6,
      "text": "สอนหน่อยสอนหน่อยอะไรเงี้ยน้องก็สอนน้อง"
    },
    {
      "id": 230,
      "start": 461.92,
      "end": 465.84,
      "text": "ก็บอกว่านี่น้ำมันต้องจับงี้นะพี่จังหวะ"
    },
    {
      "id": 231,
      "start": 464.6,
      "end": 467.96,
      "text": "ชี้แทงเป็นจริงๆเลยใช่ป่ะ"
    },
    {
      "id": 232,
      "start": 465.84,
      "end": 470.6,
      "text": "ไม่ไม่เป็นแบบ For  acting"
    },
    {
      "id": 233,
      "start": 467.96,
      "end": 473.36,
      "text": "อ๋อก็แบบเป็นแบบก็รู้แบบเบสิคว่าต้องยืน"
    },
    {
      "id": 234,
      "start": 470.6,
      "end": 474.24,
      "text": "ยังไงนะหลังงี้"
    },
    {
      "id": 235,
      "start": 473.36,
      "end": 476.24,
      "text": "เราก็ช่วยตลอด"
    },
    {
      "id": 236,
      "start": 474.24,
      "end": 477.52,
      "text": "ของผมก็เป็นน้องจูเนียร์ครับเหมือนจะเป็น"
    },
    {
      "id": 237,
      "start": 476.24,
      "end": 478.4,
      "text": "นักกีฬาทีมชาติมั้ง"
    },
    {
      "id": 238,
      "start": 477.52,
      "end": 479.16,
      "text": "สูงเท่าไหร่"
    },
    {
      "id": 239,
      "start": 478.4,
      "end": 479.72,
      "text": "สูงเท่าไหร่"
    },
    {
      "id": 240,
      "start": 479.16,
      "end": 480.76,
      "text": "เท่าไหร่จริงๆ"
    },
    {
      "id": 241,
      "start": 479.72,
      "end": 482.8,
      "text": "ไม่ถึงไหล่ด้วยซ้ำ"
    },
    {
      "id": 242,
      "start": 480.76,
      "end": 484.84,
      "text": "ไม่ถึงไหลด้วยซ้ำเพอร์เซปกติก็เป็นฟิลนี้"
    },
    {
      "id": 243,
      "start": 482.8,
      "end": 487.08,
      "text": "แหละเป็นหลุดๆบ้าๆบอๆนั่นแหละครับแต่ว่า"
    },
    {
      "id": 244,
      "start": 484.84,
      "end": 488.92,
      "text": "แค่ MV อื่นมันแบบมาครอบไว้"
    },
    {
      "id": 245,
      "start": 487.08,
      "end": 490.12,
      "text": "แต่ความจริงแล้วอันนี้คือถนัดมันเล่นเป็น"
    },
    {
      "id": 246,
      "start": 488.92,
      "end": 493.64,
      "text": "ธรรมชาติมากใช่มั้"
    },
    {
      "id": 247,
      "start": 490.12,
      "end": 494.48,
      "text": "ใช่ครับผมเรียกได้ว่านอกจอทำทรงเอ้ยใน"
    },
    {
      "id": 248,
      "start": 493.64,
      "end": 495.04,
      "text": "กล้องทำทรง"
    },
    {
      "id": 249,
      "start": 494.48,
      "end": 498.36,
      "text": "แล้วนอกจอ"
    },
    {
      "id": 250,
      "start": 495.04,
      "end": 500.2,
      "text": "นอกจอทำทรงนอกจากคอมเหมือนเดิมแต่อันนี้"
    },
    {
      "id": 251,
      "start": 498.36,
      "end": 501.48,
      "text": "คือเป็นสิ่งที่พี่เนไม่ถนัดใน MV พี่เน"
    },
    {
      "id": 252,
      "start": 500.2,
      "end": 503.96,
      "text": "ไม่ถนัดแบบ"
    },
    {
      "id": 253,
      "start": 501.48,
      "end": 506.96,
      "text": "ไม่ถนัดไม่ถนัดคือปกติเขาจะเป็นตัวนี้ติด"
    },
    {
      "id": 254,
      "start": 503.96,
      "end": 508.36,
      "text": "แต่เป็น MV ที่เรียกได้ว่าพวกเราแยกกัน"
    },
    {
      "id": 255,
      "start": 506.96,
      "end": 510.24,
      "text": "ถ่ายเยอะมากๆ"
    },
    {
      "id": 256,
      "start": 508.36,
      "end": 513.2,
      "text": "ถือว่าแบบทุกคนได้ใช้เวลาของตัวเองอะไร"
    },
    {
      "id": 257,
      "start": 510.24,
      "end": 515.48,
      "text": "อย่างเงี้ยแล้วแล้วก็ไม่คือมันเป็นข้อดี"
    },
    {
      "id": 258,
      "start": 513.2,
      "end": 518.16,
      "text": "ในการมาดู MV คือเราไม่เคยเห็นของเพื่อน"
    },
    {
      "id": 259,
      "start": 515.48,
      "end": 520.8,
      "text": "มาก่อนเลยเพราะว่าไม่มีใครเดินไปหน้าเซต"
    },
    {
      "id": 260,
      "start": 518.16,
      "end": 523.84,
      "text": "เลยแม้แต่คนเดียวแล้วก็หมดคิวปุ๊บกลับเลย"
    },
    {
      "id": 261,
      "start": 520.8,
      "end": 526.92,
      "text": "นะครับเราก็เลยได้มาแบบรีแอคชัแบบซีนของ"
    },
    {
      "id": 262,
      "start": 523.84,
      "end": 528.88,
      "text": "เพื่อนๆเต็มๆแต่ว่าแบบอุ๊ยแบบว้าวอย่าง"
    },
    {
      "id": 263,
      "start": 526.92,
      "end": 530.24,
      "text": "งี้เลยแบบไม่เห็นคาดคิด"
    },
    {
      "id": 264,
      "start": 528.88,
      "end": 531.84,
      "text": "เออไม่คาดคิดเลย"
    },
    {
      "id": 265,
      "start": 530.24,
      "end": 532.12,
      "text": "แต่อันนี้เป็นอวีที่เราแยกกันเยอะที่สุด"
    },
    {
      "id": 266,
      "start": 531.84,
      "end": 532.52,
      "text": "แล้วป่ะ"
    },
    {
      "id": 267,
      "start": 532.12,
      "end": 533.4,
      "text": "ใช่มั้ย"
    },
    {
      "id": 268,
      "start": 532.52,
      "end": 533.64,
      "text": "เยอะสุดแล้ว"
    },
    {
      "id": 269,
      "start": 533.4,
      "end": 535.72,
      "text": "เออ"
    },
    {
      "id": 270,
      "start": 533.64,
      "end": 536.08,
      "text": "เราเจอกันแค่ตอนเต้นแล้วเราก็ไม่เจอกัน"
    },
    {
      "id": 271,
      "start": 535.72,
      "end": 538.0,
      "text": "อีก"
    },
    {
      "id": 272,
      "start": 536.08,
      "end": 539.6,
      "text": "ใช่ไม่ค่อยเจอกันเลยเจอตอนสุดท้ายของ"
    },
    {
      "id": 273,
      "start": 538.0,
      "end": 540.6,
      "text": "ปาล์มที่วิ่ง"
    },
    {
      "id": 274,
      "start": 539.6,
      "end": 544.2,
      "text": "แล้วก็แวกเลย"
    },
    {
      "id": 275,
      "start": 540.6,
      "end": 545.2,
      "text": "ไม่แพ้ใครที่ไม่แพ้เหรอครับขนแมวแล้วกัน"
    },
    {
      "id": 276,
      "start": 544.2,
      "end": 545.72,
      "text": "ไม่แพ้ขนแมว"
    },
    {
      "id": 277,
      "start": 545.2,
      "end": 547.68,
      "text": "แพ้เวอร์"
    },
    {
      "id": 278,
      "start": 545.72,
      "end": 548.52,
      "text": "เเลี้ยงอยู่ไงเลี้ยงแมวแล้วไม่แพ้ไง"
    },
    {
      "id": 279,
      "start": 547.68,
      "end": 549.96,
      "text": "ไม่เคยแพ้เลยใช่ป่ะ"
    },
    {
      "id": 280,
      "start": 548.52,
      "end": 553.52,
      "text": "ไม่เคยแพ้โอเค"
    },
    {
      "id": 281,
      "start": 549.96,
      "end": 554.0,
      "text": "ก็ถือว่าดีเหรอของผมเป็นเรื่องพูด"
    },
    {
      "id": 282,
      "start": 553.52,
      "end": 556.16,
      "text": "อ่า"
    },
    {
      "id": 283,
      "start": 554.0,
      "end": 556.72,
      "text": "ไม่แพ้ใครนะครับเรื่องจริง"
    },
    {
      "id": 284,
      "start": 556.16,
      "end": 559.32,
      "text": "อันนี้เรื่องจริง"
    },
    {
      "id": 285,
      "start": 556.72,
      "end": 560.24,
      "text": "เรื่องจริงผ่านจอเวอร์ผมเป็นเรื่องเงียบ"
    },
    {
      "id": 286,
      "start": 559.32,
      "end": 563.76,
      "text": "แล้วกัน"
    },
    {
      "id": 287,
      "start": 560.24,
      "end": 564.16,
      "text": "ถูก[เสียงหัวเราะ]มาเสมอ 4 ปีที่ผ่านมา"
    },
    {
      "id": 288,
      "start": 563.76,
      "end": 566.6,
      "text": "ครับผม"
    },
    {
      "id": 289,
      "start": 564.16,
      "end": 566.8,
      "text": "ใช่ครับจะทำดีทำต่อไปครับผม"
    },
    {
      "id": 290,
      "start": 566.6,
      "end": 570.56,
      "text": "จ"
    },
    {
      "id": 291,
      "start": 566.8,
      "end": 572.16,
      "text": "ผมเป็นเรื่องทำงานแล้วกันครับก็ถูกครับผม"
    },
    {
      "id": 292,
      "start": 570.56,
      "end": 572.72,
      "text": "ใครจะไปชนะชี"
    },
    {
      "id": 293,
      "start": 572.16,
      "end": 575.88,
      "text": "เออ"
    },
    {
      "id": 294,
      "start": 572.72,
      "end": 579.16,
      "text": "ผมไม่แพ้ใครเรื่องอะไรหรอเรื่องความรักสิ"
    },
    {
      "id": 295,
      "start": 575.88,
      "end": 580.68,
      "text": "เพราะว่าแข่งกันเรื่องความรักชีฟูงจริงๆ"
    },
    {
      "id": 296,
      "start": 579.16,
      "end": 583.52,
      "text": "ไม่แพ้ใครไง"
    },
    {
      "id": 297,
      "start": 580.68,
      "end": 584.0,
      "text": "เออว่าปิดได้สวยฝาก MV เลย"
    },
    {
      "id": 298,
      "start": 583.52,
      "end": 588.24,
      "text": "อ"
    },
    {
      "id": 299,
      "start": 584.0,
      "end": 590.56,
      "text": "ฝากด้วยนะครับไม่แพ้ใคร Dan  X นะครับไป"
    },
    {
      "id": 300,
      "start": 588.24,
      "end": 592.0,
      "text": "ดูกันเยอะๆไปฟังกันเยอะๆไปเต้นกันด้วยนะ"
    },
    {
      "id": 301,
      "start": 590.56,
      "end": 593.44,
      "text": "ครับ"
    },
    {
      "id": 302,
      "start": 592.0,
      "end": 595.2,
      "text": "ครับผมฝากด้วย"
    },
    {
      "id": 303,
      "start": 593.44,
      "end": 598.32,
      "text": "[เพลง]"
    },
    {
      "id": 304,
      "start": 595.2,
      "end": 598.32,
      "text": "I  know  you  want  me"
    }
  ]
}