      "id": 232,
      "start": 442.72,
      "end": 446.8,
      "text": "แต่ว่าเรามีเพลงใหม่อีกเพลงนึง"
    },
    {
      "id": 233,
      "start": 445.0,
      "end": 450.12,
      "text": "เฮ้ย"
    },
    {
      "id": 234,
      "start": 446.8,
      "end": 452.88,
      "text": "ซึ่งทุกคนที่ได้รับอัลบั้มในวันที่ 3"
    },
    {
      "id": 235,
      "start": 450.12,
      "end": 454.6,
      "text": "เนี่ยก็จะได้ฟังเพลงนี้ก่อนใครอัลบั้มแรก"
    },
    {
      "id": 236,
      "start": 452.88,
      "end": 456.76,
      "text": "เนี่ยมันมีชื่อเพลงว่า My  Time เพลงนี้"
    },
    {
      "id": 237,
      "start": 454.6,
      "end": 460.08,
      "text": "ชื่อภาษาอังกฤษชื่อว่า Our  Time"
    },
    {
      "id": 238,
      "start": 456.76,
      "end": 463.08,
      "text": "อุย Our  Time แล้วอัลบั้มต่อไปอะไร Time"
    },
    {
      "id": 239,
      "start": 460.08,
      "end": 465.28,
      "text": "up นะครับผมเออนะครับผม"
    },
    {
      "id": 240,
      "start": 463.08,
      "end": 466.68,
      "text": "หมดเวลาแล้วนะครับ[เสียงหัวเราะ]"
    },
    {
      "id": 241,
      "start": 465.28,
      "end": 471.08,
      "text": "นี้บอกเลยว่าชื่อเพลงอะไร"
    },
    {
      "id": 242,
      "start": 466.68,
      "end": 474.64,
      "text": "เออชื่อเพลงว่าอยู่คนเดียวยังไงไหวเทางนะ"
    },
    {
      "id": 243,
      "start": 471.08,
      "end": 477.04,
      "text": "ครับผมเพลงนี้เนี่ยก็มันเป็นเพลงที่มี"
    },
    {
      "id": 244,
      "start": 474.64,
      "end": 478.88,
      "text": "ความหมายแบบว่ามีความอบอุ่นที่แบบว่า"
    },
    {
      "id": 245,
      "start": 477.04,
      "end": 482.24,
      "text": "เหมือนเราอยากบอกใครสักคนว่าแบบเอ้ยเรา"
    },
    {
      "id": 246,
      "start": 478.88,
      "end": 483.72,
      "text": "อยู่คนเดียวไม่ได้แล้วแบบไม่ไหวแล้วกับ"
    },
    {
      "id": 247,
      "start": 482.24,
      "end": 486.2,
      "text": "การมีทุกคนเลย"
    },
    {
      "id": 248,
      "start": 483.72,
      "end": 488.52,
      "text": "อ่าแล้วก็มันเป็นเหมือนเป็นเพลงสเปชลที่"
    },
    {
      "id": 249,
      "start": 486.2,
      "end": 491.24,
      "text": "เราอยากมอบให้พีเซอร์ทุกคนเหมือนอัลบั้ม"
    },
    {
      "id": 250,
      "start": 488.52,
      "end": 494.28,
      "text": "ที่แล้วเราก็จะมีเพลง Beautyful ที่มาแบบ"
    },
    {
      "id": 251,
      "start": 491.24,
      "end": 496.24,
      "text": "ปิดอัลบั้มเพื่อแบบเป็นเพลงให้กับทุกคน"
    },
    {
      "id": 252,
      "start": 494.28,
      "end": 498.32,
      "text": "ให้พีเซอร์ทุกคนที่แบบอยู่กับพวกเรามา"
    },
    {
      "id": 253,
      "start": 496.24,
      "end": 502.16,
      "text": "ซึ่งอัลบั้มแลนด์ก็มีเพลงนี้เหมือนกันที่"
    },
    {
      "id": 254,
      "start": 498.32,
      "end": 507.56,
      "text": "แบบว่าเราอยากมอบให้พีทุกคนครับผมแต่ว่า"
    },
    {
      "id": 255,
      "start": 502.16,
      "end": 512.6,
      "text": "อยู่คนเดียวไงวไม่มีเธอคงไม่ช"
    },
    {
      "id": 256,
      "start": 507.56,
      "end": 512.6,
      "text": "นิดนึงมากครับ"
    },
    {
      "id": 257,
      "start": 514.36,
      "end": 516.72,
      "text": "แขน"
    },
    {
      "id": 258,
      "start": 515.92,
      "end": 519.56,
      "text": "แขนมาก"
    },
    {
      "id": 259,
      "start": 516.72,
      "end": 523.36,
      "text": "ไม่อยากจะเปลี่ยนไปแค่นี้เท่าไหร่"
    },
    {
      "id": 260,
      "start": 519.56,
      "end": 526.24,
      "text": "ครับผมก็ขอบคุณพิเศษทุกคนนะครับผมที่สั่ง"
    },
    {
      "id": 261,
      "start": 523.36,
      "end": 528.2,
      "text": "จองอัลบั้มนี้ไปนะครับผมแล้วก็ขอบคุณที่"
    },
    {
      "id": 262,
      "start": 526.24,
      "end": 531.24,
      "text": "สนับสนุนพวกเรามาตลอดนะครับก็เดี๋เราเจอ"
    },
    {
      "id": 263,
      "start": 528.2,
      "end": 533.24,
      "text": "กันในแฟนชชายเนาะแล้วก็ในคอชายนะครับ"
    },
    {
      "id": 264,
      "start": 531.24,
      "end": 537.28,
      "text": "ทุกคนจะต้องประทับใจแน่นอนอัลบั้ม"
    },
    {
      "id": 265,
      "start": 533.24,
      "end": 538.52,
      "text": "ใช่ครับฝากไว้ค่ะครับ"
    },
    {
      "id": 266,
      "start": 537.28,
      "end": 541.75,
      "text": "อน"
    },
    {
      "id": 267,
      "start": 538.52,
      "end": 541.75,
      "text": "Yeah. [เพลง]"
    }
  ]
