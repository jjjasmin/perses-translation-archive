  "transcript": [
    {
      "id": 1,
      "start": 6.97,
      "end": 11.35,
      "text": "Hmm.. ฉันนึกไม่ออกจริงๆ ถ้าไม่มีเธอจะเป็นยังไง"
    },
    {
      "id": 2,
      "start": 12.77,
      "end": 18.33,
      "text": "นึกไม่ออกเลยว่าวันนี้ชีวิตจะไปทางไหน"
    },
    {
      "id": 3,
      "start": 18.33,
      "end": 21.48,
      "text": "เธอเติมเต็มให้โลกของฉันไม่ว่างเปล่า"
    },
    {
      "id": 4,
      "start": 21.48,
      "end": 24.81,
      "text": "เธอเปลี่ยนวันธรรมดาของฉันไปมากมาย"
    },
    {
      "id": 5,
      "start": 24.81,
      "end": 30.5,
      "text": "ก็นึกไม่ออกจริงๆ ถ้าฉันต้องอยู่คนเดียว"
    },
    {
      "id": 6,
      "start": 30.5,
      "end": 33.37,
      "text": "You’re the missing piece that completes my whole heart"
    },
    {
      "id": 7,
      "start": 33.37,
      "end": 36.33,
      "text": "ได้เจอเธอแล้วชิ้นส่วนที่ตามหา"
    },
    {
      "id": 8,
      "start": 36.33,
      "end": 39.92,
      "text": "หากว่าวันพรุ่งนี้ไม่มีเธอข้างกัน"
    },
    {
      "id": 9,
      "start": 39.92,
      "end": 42.4,
      "text": "ฉันจะอยู่ยังไง"
    },
    {
      "id": 10,
      "start": 42.4,
      "end": 45.07,
      "text": "อยู่คนเดียวยังไงไหว"
    },
    {
      "id": 11,
      "start": 45.07,
      "end": 48.48,
      "text": "ไม่มีเธอยังไงก็คงไม่ชิน"
    },
    {
      "id": 12,
      "start": 48.48,
      "end": 51.73,
      "text": "อยู่คนเดียวก็คงไม่ได้ยิน"
    },
    {
      "id": 13,
      "start": 51.73,
      "end": 55.68,
      "text": "เสียงหัวเราะเดิมๆที่เคยฟังทุกวันจากเธอ"
    },
    {
      "id": 14,
      "start": 55.68,
      "end": 61.51,
      "text": "หากไม่มีเธออยู่ข้างกัน ฉันคงเหงาตาย"
    },
    {
      "id": 15,
      "start": 61.51,
      "end": 64.08,
      "text": "อยู่คนเดียวยังไงไหว"
    },
    {
      "id": 16,
      "start": 64.08,
      "end": 68.26,
      "text": "อยากอยู่กับเธอทุกวัน ทุกวัน ทุกวัน เรื่อยๆไป"
    },
    {
      "id": 17,
      "start": 68.26,
      "end": 71.67,
      "text": "Hey! ก็อยู่คนเดียวเป็นไงมันก็เกือบลืมไปแล้วอะ"
    },
    {
      "id": 18,
      "start": 71.67,
      "end": 74.85,
      "text": "นี่ไม่ได้อ้อนหรือว่าจะเอาแต่ใจตัวเองนะ"
    },
    {
      "id": 19,
      "start": 74.85,
      "end": 77.88,
      "text": "แต่คิดว่าการมีเธออยู่ด้วยกันมันดีกว่า"
    },
    {
      "id": 20,
      "start": 77.88,
      "end": 80.36,
      "text": "เปลี่ยน my time ให้กลายเป็น our times"
    },
    {
      "id": 21,
