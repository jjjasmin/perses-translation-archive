      "text": "แบบฝึกหยอกยอกแบบเฮ้ยเขินนะเธออะไรเงี้ย"
    },
    {
      "id": 111,
      "start": 475.96,
      "end": 483.32,
      "text": "มาเล่นหัวเราทำไมไม่ใช่ไม่ใช่เราเขินเรา"
    },
    {
      "id": 112,
      "start": 480.2,
      "end": 485.36,
      "text": "แล้วแบบมารูบหัวเราทำไมเราเขินเราได้ข่าว"
    },
    {
      "id": 113,
      "start": 483.32,
      "end": 489.12,
      "text": "ว่า MV นี้เนี่ยพี่จั๋จะเป็นพระเอก MV"
    },
    {
      "id": 114,
      "start": 485.36,
      "end": 492.52,
      "text": "เตรียมตัวยังไงบ้างเฮ้ยเฮ้ยผมแดงใช่มั้"
    },
    {
      "id": 115,
      "start": 489.12,
      "end": 496.08,
      "text": "คันนั้นจะได้เป็นพระเอกคันนี้ผมแดงเหรอ"
    },
    {
      "id": 116,
      "start": 492.52,
      "end": 500.2,
      "text": "อันนี้อันนี้แดงเหรอสำหรับคลิปซ้อมนะครับ"
    },
    {
      "id": 117,
      "start": 496.08,
      "end": 503.52,
      "text": "ก็จบไว้เท่านี้นะครับอย่างงี้เลยหรอใช่ก็"
    },
    {
      "id": 118,
      "start": 500.2,
      "end": 505.76,
      "text": "จบเลยไงไม่ต้องบอกเขาก็ได้ว่ามันเป็นคิ 2"
    },
    {
      "id": 119,
      "start": 503.52,
      "end": 508.56,
      "text": "ก็ได้ก็สำหรับช่วองเอซเตรียมตัวเพื่อถ่าย"
    },
    {
      "id": 120,
      "start": 505.76,
      "end": 510.2,
      "text": "MV เนี่ยก็เรียบร้อยครับอืเรียบร้อยแล้ว"
    },
    {
      "id": 121,
      "start": 508.56,
      "end": 513.28,
      "text": "เดี๋ยวเดี๋พรุ่งนี้ก็ไปถ่าย MV แล้วครับ"
    },
    {
      "id": 122,
      "start": 510.2,
      "end": 516.88,
      "text": "รอดูกันว่าแบบในกองจะเป็นยังไงจะแบบเอ้ยๆ"
    },
    {
      "id": 123,
      "start": 513.28,
      "end": 519.8,
      "text": "ยังไงยังไงใช่ซึ่งอีกคลิปนึงเออต้องรอดู"
    },
    {
      "id": 124,
      "start": 516.88,
      "end": 521.6,
      "text": "นี่ไงไปตามดูครับก็ตามไปดูอีกคลิปนึงครับ"
    },
    {
      "id": 125,
      "start": 519.8,
      "end": 525.24,
      "text": "คลิปได้ MV เลยครับคีย์เวิร์ดคลิปนึงเจอ"
    },
    {
      "id": 126,
      "start": 521.6,
      "end": 525.24,
      "text": "กันครับอีกคลิปนึงไปบ๊ายบาย"
    },
    {
      "id": 127,
      "start": 525.36,
      "end": 528.36,
      "text": "ไป"
    }
  ]
}