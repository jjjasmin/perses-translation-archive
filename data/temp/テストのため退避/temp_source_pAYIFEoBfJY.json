    {
      "id": 169,
      "start": 630.12,
      "end": 636.96,
      "text": "ไปกันไม่เสแล้วจริงๆเอวรู้สึกว่ามันเป็น"
    },
    {
      "id": 170,
      "start": 635.16,
      "end": 638.92,
      "text": "อันที่ยากมากเพราะว่าแบบเราไม่เคยเจอกัน"
    },
    {
      "id": 171,
      "start": 636.96,
      "end": 641.88,
      "text": "มาก่อนแล้วเราต้องแบบมารักกันเลิกกันใน"
    },
    {
      "id": 172,
      "start": 638.92,
      "end": 646.84,
