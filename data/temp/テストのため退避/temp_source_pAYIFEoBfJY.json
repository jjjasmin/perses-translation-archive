      "text": "เว้ยแบบว่าให้กำลังใจเพื่อนใช่ปอบหลังจาก"
    },
    {
      "id": 102,
      "start": 382.68,
      "end": 388.92,
      "text": "เห็นการเศร้า่งนะครับเป็นกำลังใจให้พี่เ"
    },
    {
      "id": 103,
      "start": 385.48,
      "end": 388.92,
      "text": "วันนี้สๆ"
    },
    {
      "id": 104,
      "start": 395.58,
      "end": 407.4,
      "text": "[เพลง]"
    },
    {
      "id": 105,
      "start": 403.92,
      "end": 409.96,
      "text": "ชิๆครับคนี้แล้วเมื่อกี้ครับเราเพิ่งถ่าย"
    },
    {
      "id": 106,
      "start": 407.4,
      "end": 412.72,
      "text": "ซีมปาร์ตี้เสร็จนะครับมันจะมี 2 อันนาง"
    },
    {
      "id": 107,
      "start": 409.96,
      "end": 415.48,
      "text": "เอกงอนแล้วเดินออกไปแล้วพี่เนจะแบบแค่มอง"
    },
    {
      "id": 108,
      "start": 412.72,
      "end": 418.16,
      "text": "เฉยๆเออก็ไม่เป็นไรอะไรสนุกกับเพื่อนต่อ"
    },
    {
      "id": 109,
      "start": 415.48,
      "end": 420.56,
      "text": "แล้วก็มันจะมีอีกเทคนึงที่แบบพี่เนจะเดิน"
    },
    {
      "id": 110,
      "start": 418.16,
      "end": 423.2,
      "text": "ตามไปแล้วตามไปง้อแบบริมสระน้ำอะไรอย่าง"
    },
    {
      "id": 111,
      "start": 420.56,
      "end": 426.56,
      "text": "งี้เพอย้อนเวลาไงพอย้อนเวลาแล้วก็เลยมี 2"
    },
    {
      "id": 112,
      "start": 423.2,
      "end": 429.0,
      "text": "ซิเออเป็นฟิวแบบได้คุยกับไม่คุยเป็นฟิว"
    },
    {
      "id": 113,
      "start": 426.56,
      "end": 429.0,
      "text": "นั้นอะไร"
    },
    {
      "id": 114,
      "start": 429.52,
      "end": 439.6,
      "text": "เงี้ยโอเคครับโอเคดีนะเออตงนี้รออันนี้"
    },
    {
      "id": 115,
      "start": 434.6,
      "end": 442.6,
      "text": "รอนั่นแหละนั่นแหละมองเค้กอ่ะแล้วมองหน้า"
    },
    {
      "id": 116,
      "start": 439.6,
      "end": 446.76,
      "text": "กันยิ้มๆอีกทีนึงนะนี่สุด"
    },
    {
      "id": 117,
      "start": 442.6,
      "end": 449.88,
      "text": "ยอดได้ะโอเคครับเรียบร้อยซีนเมื่อกี้ก็"
    },
    {
      "id": 118,
      "start": 446.76,
      "end": 452.52,
      "text": "เป็นซีนที่เราตอนแรกลืมวันเกิดเขาวเรา"
    },
    {
      "id": 119,
      "start": 449.88,
      "end": 454.92,
      "text": "กลับมาทำงานมาเหนื่อๆเลยแล้วก็เห็นขอรอ"
    },
    {
      "id": 120,
      "start": 452.52,
      "end": 457.56,
      "text": "อยู่เป็นวันเกิดเขาขอรอแบบมาฉลองกับเรา"
    },
    {
      "id": 121,
      "start": 454.92,
      "end": 460.32,
      "text": "แบบใช้เวลาร่วมกันแบบว่าลืมครับแล้วก็แบบ"
    },
    {
      "id": 122,
      "start": 457.56,
      "end": 463.88,
      "text": "ไปทำงานต่อแต่ว่าเราก็แบบย้อนเวลากลับมา"
    },
    {
      "id": 123,
      "start": 460.32,
      "end": 466.04,
      "text": "เพื่อไม่ใช้เวลากับเขามาแบบซื้อเค้กมาให้"
    },
    {
      "id": 124,
      "start": 463.88,
      "end": 466.04,
      "text": "อะไร"
    },
    {
      "id": 125,
      "start": 466.4,
      "end": 483.08,
      "text": "งี้ปล่อยให้น้ำตาไไปไม่รู้ว่าจะฝืนทำไม"
    },
    {
      "id": 126,
      "start": 474.28,
      "end": 486.06,
      "text": "ถ้าตอสุดท้ายอไปอยู่ดีโปรดเลยอย่าฝืนเเรา"
    },
    {
      "id": 127,
      "start": 483.08,
      "end": 489.2,
      "text": "ไปกันไม่ไหวเ"
    },
    {
      "id": 128,
      "start": 486.06,
      "end": 489.2,
      "text": "[ปรบมือ]"
    },
    {
      "id": 129,
      "start": 490.52,
      "end": 500.52,
      "text": "ไผมทำดีที่สุด่ะพี่ผมทำดีที่สุด่ะพี่ผมทำ"
    },
    {
      "id": 130,
      "start": 493.84,
      "end": 507.64,
      "text": "ดีที่สุด่ะพี่ได้ลอเลยอย่าฟืนเธอเราไปกัน"
    },
    {
      "id": 131,
      "start": 500.52,
      "end": 515.6,
      "text": "ไม่ไวให้มันจบทุกนี้คงดีกว่าต้องกลับคลืน"
    },
    {
      "id": 132,
      "start": 507.64,
      "end": 523.44,
      "text": "ใช่ไเต้องร้องปล่อยให้น้ำตาหลายไปไม่รู้"
    },
    {
      "id": 133,
      "start": 515.6,
      "end": 526.72,
      "text": "ว่าจะฝืนทำมเตอนสุดท้ายต้องไปอยู่ดีเมื่อ"
    },
    {
      "id": 134,
      "start": 523.44,
      "end": 529.72,
      "text": "กี้นะครับก็จะเป็นซีนซิงของแต่ละคนคือแบบ"
