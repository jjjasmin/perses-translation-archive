      "text": "อยู่แอบไบโพล่ามึนๆจริงจริงก็ชอบอมิมาก"
    },
    {
      "id": 174,
      "start": 646.84,
      "end": 660.36,
      "text": "ที่แบบวเก๋เวอร์ชอบมากเลยอ่ะเมาก 1  2  3"
    },
    {
      "id": 175,
      "start": 653.52,
      "end": 664.8,
      "text": "2  1  2  3  3  2  3"
    },
    {
      "id": 176,
      "start": 660.36,
      "end": 664.8,
      "text": "1  2  3"
