    {
      "id": 265,
      "start": 663.16,
      "end": 665.52,
      "text": "มาตอนไหน"
    },
    {
      "id": 266,
      "start": 664.0,
      "end": 667.72,
      "text": "ในที่สุดก็เป็นของแกเมื่อกี้"
