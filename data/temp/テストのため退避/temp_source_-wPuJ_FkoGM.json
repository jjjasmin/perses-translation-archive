    {
      "id": 242,
      "start": 608.76,
      "end": 613.12,
      "text": "อ่าขอบคุณพี่จีนนะครับ"
    },
    {
      "id": 243,
      "start": 611.16,
      "end": 615.76,
      "text": "ครับสไว้ใจผลงานกับพี่จีนมากๆ"
    },
    {
      "id": 244,
      "start": 613.12,
      "end": 619.32,
      "text": "เพลงนี้ก็จะเห็นได้ชัดว่าเพอเซก็จะเต้น"
    },
    {
      "id": 245,
      "start": 615.76,
      "end": 622.26,
      "text": "อีกแบบแนวนึงสไตล์นึงมันจะมีความเลื่อยๆ"
    },
    {
      "id": 246,
      "start": 619.32,
      "end": 623.52,
      "text": "หน่อยมีความแบบไม่ได้ล็อกท่าเลื้อย"
