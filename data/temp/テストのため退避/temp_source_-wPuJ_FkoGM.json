    {
      "id": 258,
      "start": 646.4,
      "end": 652.52,
      "text": "คอยถามปักกี้แบบยังไงเซ็กซี่ยังไงดีแล้ว"
    },
    {
      "id": 259,
      "start": 650.2,
      "end": 655.4,
      "text": "เพลงนี้มันเป็นท่าเต้นที่แบบมันต้องเต้น"
    },
    {
      "id": 260,
      "start": 652.52,
      "end": 656.96,
      "text": "แบบต่อกันไปเรื่อยๆถ้าแบบมีท่า stop อะไร"
    },
    {
      "id": 261,
      "start": 655.4,
      "end": 657.52,
      "text": "เงี้ยก็เลยจะยากนิดนึงอ"
