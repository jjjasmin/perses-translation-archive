      "id": 233,
      "start": 589.6,
      "end": 592.84,
      "text": "เรื่องsoundวดีไซน์ตอนจบมาที่เป็นแบบ"
    },
    {
      "id": 234,
      "start": 591.64,
      "end": 596.77,
      "text": "เสียงเท้า"
    },
    {
      "id": 235,
      "start": 592.84,
      "end": 596.77,
      "text": "ในตอนซีนเต้นสุดท้าย[เพลง]"
    },
    {
      "id": 236,
      "start": 599.52,
      "end": 602.04,
      "text": "จะให้พี่จิมไปอัดเสียงเท้าตัวเองแล้วก็"
    },
    {
      "id": 237,
      "start": 601.32,
      "end": 603.92,
      "text": "ใส่เข้ามาเลย"
    },
    {
      "id": 238,
      "start": 602.04,
      "end": 604.64,
      "text": "อู้จริงเหรอเนี่ยแอบเต้นอยู่บ้าน"
    },
    {
      "id": 239,
      "start": 603.92,
      "end": 605.6,
      "text": "[เสียงหัวเราะ]"
    },
    {
      "id": 240,
      "start": 604.64,
      "end": 608.76,
      "text": "เต้นเหรอ"
    },
    {
      "id": 241,
      "start": 605.6,
      "end": 611.16,
      "text": "ไม่ตัดอยู่ไงแล้วแบบสนุกดีก็อยาก"
