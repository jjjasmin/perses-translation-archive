      "id": 221,
      "start": 514.24,
      "end": 516.24,
      "text": "ไอ้ตรงนี้ว่าจะใส่จูนอยู่แล้วป่ะ"
    },
    {
      "id": 222,
      "start": 515.96,
      "end": 516.92,
      "text": "ใช่"
    },
    {
      "id": 223,
      "start": 516.24,
      "end": 518.4,
      "text": "ใช่ป่ะ"
    },
    {
      "id": 224,
      "start": 516.92,
      "end": 520.0,
      "text": "มันต้องลองให้มันติดนิดนึงอ่ะ"
    },
    {
      "id": 225,
      "start": 518.4,
      "end": 520.84,
      "text": "หรือว่าจะเปิดจูนมั้ย"
    },
    {
      "id": 226,
      "start": 520.0,
      "end": 522.72,
      "text": "ไม่เคยลองอัดแบบ"
    },
    {
      "id": 227,
      "start": 520.84,
      "end": 523.6,
      "text": "อันนี้ก็เปิดอยู่นะเปิดไว้หน่อยเดี๋พี่จ๋"
    },
    {
      "id": 228,
      "start": 522.72,
      "end": 527.36,
      "text": "ลองดูดีกว่า"
    },
    {
      "id": 229,
      "start": 523.6,
      "end": 527.36,
      "text": "จะได้ฟิลองดู"
    },
    {
      "id": 230,
      "start": 529.48,
      "end": 532.68,
      "text": "mode"
    },
    {
      "id": 231,
      "start": 531.21,
      "end": 534.12,
      "text": "[เสียงหัวเราะ]อลองดูลองดู"
    },
    {
      "id": 232,
      "start": 532.68,
      "end": 535.72,
      "text": "ารมนี่มันมีโนตครับหรือว่า"
    },
    {
      "id": 233,
      "start": 534.12,
      "end": 538.72,
      "text": "ไม่มีเลย"
    },
    {
      "id": 234,
      "start": 535.72,
      "end": 538.72,
      "text": "เออ"
    },
    {
      "id": 235,
      "start": 542.36,
      "end": 548.04,
      "text": "เฮ้ยโมดีนะดี"
    },
    {
      "id": 236,
      "start": 544.68,
      "end": 548.04,
      "text": "หามดี"
    },
    {
      "id": 237,
      "start": 550.64,
      "end": 552.76,
      "text": "อันนี้อันนี้ดูเท่ดีนะ"
    },
    {
      "id": 238,
      "start": 552.24,
      "end": 555.12,
      "text": "อื"
    },
    {
      "id": 239,
      "start": 552.76,
      "end": 557.56,
      "text": "อุ้ยเป็นการอัดกับอจูครั้งแรกเป็นอะไร"
    },
    {
      "id": 240,
      "start": 555.12,
      "end": 559.36,
      "text": "ใหม่ๆมากๆเลยแล้วก็สนุกมากแล้วก็รู้สึก"
    },
    {
      "id": 241,
      "start": 557.56,
      "end": 562.08,
      "text": "ว่านามพาไปเร็วมากเลยตอนอ"
    },
    {
      "id": 242,
      "start": 559.36,
      "end": 565.0,
      "text": "ยิ้มจมไว้เธอชิมอภิ"
    },
    {
      "id": 243,
      "start": 562.08,
      "end": 568.24,
      "text": "โอโหร"
    },
    {
      "id": 244,
      "start": 565.0,
      "end": 568.24,
      "text": "อีกนิดนึง"
    },
    {
      "id": 245,
      "start": 569.64,
      "end": 573.19,
      "text": "ช"
    },
    {
      "id": 246,
      "start": 569.96,
      "end": 573.19,
      "text": "ขนลุกนิดนึงเดี๋ดี[เสียงหัวเราะ]"
    },
    {
      "id": 247,
      "start": 573.56,
      "end": 578.84,
      "text": "ไปพคอัสนะครับ"
    },
    {
      "id": 248,
      "start": 574.68,
      "end": 582.6,
      "text": "นะครับผมดีกว่าพี่ไม่มีอีกแล้วจะปฏิเสธ"
    },
    {
      "id": 249,
      "start": 578.84,
      "end": 584.16,
      "text": "ได้ไงดีกว่านี้ไม่มีเพราะพักปองว่าเกิน"
    },
    {
      "id": 250,
      "start": 582.6,
      "end": 585.4,
      "text": "ห้าม[เสียงร้องเพลง]ใจ"
    },
    {
      "id": 251,
      "start": 584.16,
      "end": 588.96,
      "text": "ได้ป่ะแต่นี้ดี"
    },
    {
      "id": 252,
      "start": 585.4,
      "end": 591.48,
      "text": "อือๆพอได้ทำงานจริงๆก็แฮปปี้มากครับว่า"
    },
    {
      "id": 253,
      "start": 588.96,
      "end": 593.16,
      "text": "แบบพี่ๆน่ารักมากแล้วก็จะบอกว่าผมเป็น"
    },
    {
      "id": 254,
      "start": 591.48,
      "end": 595.76,
      "text": "แฟนคลับพี่ดีเจเมื่อกี้ตอนร้องคือเก็บ"
    },
    {
      "id": 255,
      "start": 593.16,
      "end": 597.84,
      "text": "อาการสุดๆอยากได้พี่ทเจมาทำตั้งแต่"
    },
    {
      "id": 256,
      "start": 595.76,
      "end": 600.4,
      "text": "อัลบั้มแรกแล้วรู้สึกเป็นเกียรติมากๆครับ"
    },
    {
      "id": 257,
      "start": 597.84,
      "end": 603.52,
      "text": "ผมจะเป็นโมเมนต์ที่จดจำอีกนานเลยครับเพลง"
    },
    {
      "id": 258,
      "start": 600.4,
      "end": 606.2,
      "text": "นี้มันมีความขี้เล่นแบบในสไตล์ของพี่ทีเจ"
    },
    {
      "id": 259,
      "start": 603.52,
      "end": 609.32,
      "text": "ครับแบบเอาความคิดเล่นของเพซฟมาใส่แบบไม่"
    },
    {
      "id": 260,
      "start": 606.2,
      "end": 611.72,
      "text": "มีอีกแล้วนะคนแบบฉันน่ะเธอหาไม่ได้หรอกนะ"
    },
    {
      "id": 261,
      "start": 609.32,
      "end": 615.08,
      "text": "อะไรอย่างงี้แล้วก็จะมีแบบพิหยอกล้ออะไร"
    },
    {
      "id": 262,
      "start": 611.72,
      "end": 617.28,
      "text": "อย่างงี้เป็นเพลงที่สนุกขึ้นมีความขิงๆ"
    },
    {
      "id": 263,
      "start": 615.08,
      "end": 620.68,
      "text": "ไอ้โย่อะไรเงี้ยผมว่าส่วนใหญ่จะเน้นไปที่"
    },
    {
      "id": 264,
      "start": 617.28,
      "end": 624.08,
      "text": "แรปผมลองให้ท่อนพีฮุคนิดหน่อยแล้วก็ท่อน"
    },
    {
      "id": 265,
      "start": 620.68,
      "end": 625.8,
      "text": "ฮุคแล้วก็ท่อนท่อนเ a  little  bit"
    },
    {
      "id": 266,
      "start": 624.08,
      "end": 626.36,
      "text": "เราไปที่เ 1 เลยเนาะ"
    },
    {
      "id": 267,
      "start": 625.8,
      "end": 627.96,
      "text": "ครับผม"
    },
    {
      "id": 268,
      "start": 626.36,
      "end": 631.48,
      "text": "โอเค"
    },
    {
      "id": 269,
      "start": 627.96,
      "end": 636.04,
      "text": "อยากจะว่าต้องกลับไปเหดไ"
    },
    {
      "id": 270,
      "start": 631.48,
      "end": 636.72,
      "text": "เธอว่าที่ฉันคิดว่าไม่ใช่"
    },
    {
      "id": 271,
      "start": 636.04,
      "end": 638.12,
      "text": "นานไปนิดนึง"
    },
    {
      "id": 272,
      "start": 636.72,
      "end": 640.64,
      "text": "อ่ามันจะงืดนิดนึง"
    },
    {
      "id": 273,
      "start": 638.12,
      "end": 643.36,
      "text": "เพราะว่าถ้ามันเหมือนเราเราเบ่งนานไปนิด"
    },
    {
      "id": 274,
      "start": 640.64,
      "end": 644.12,
      "text": "นึงอาจจะท่าท่าไปเลยอ่ะนึกออกมั้"
    },
    {
      "id": 275,
      "start": 643.36,
      "end": 645.72,
      "text": "อย่า"
    },
    {
      "id": 276,
      "start": 644.12,
      "end": 646.96,
      "text": "ใช่ๆแบบนั้นได้เลยครับ"
    },
    {
      "id": 277,
      "start": 645.72,
      "end": 648.08,
      "text": "มันมีออตจนด้วยใช่มั้ครับ"
    },
    {
      "id": 278,
      "start": 646.96,
      "end": 650.48,
      "text": "ใช่ครับเอามั้หรือไม่เอา"
    },
    {
      "id": 279,
      "start": 648.08,
      "end": 651.88,
      "text": "เอาไว้ก็ได้ครับแต่ว่าแค่แบบไม่"
    },
    {
      "id": 280,
      "start": 650.48,
      "end": 653.48,
      "text": "เดี๋ลดลให้นิดนึงเดี๋ลด[เสียงหัวเราะ]ให้"
    },
    {
      "id": 281,
      "start": 651.88,
      "end": 656.56,
      "text": "นิดนึง"
    },
    {
      "id": 282,
      "start": 653.48,
      "end": 657.16,
      "text": "ถ้าอยากจะว่าต้องกลับไปเห"
    },
    {
      "id": 283,
      "start": 656.56,
      "end": 661.24,
      "text": "อื"
    },
    {
      "id": 284,
      "start": 657.16,
      "end": 663.4,
      "text": "เธอเธอว่าที่ฉันคิดว่าไม่ใช่"
    },
    {
      "id": 285,
      "start": 661.24,
      "end": 666.8,
      "text": "หลังอาคมแล้วก็หน้า[เสียงสูดหายใจ]อันนี้"
    },
    {
      "id": 286,
      "start": 663.4,
      "end": 667.44,
      "text": "พีต้องพีนะลงท้ายพีไป"
    },
    {
      "id": 287,
      "start": 666.8,
      "end": 672.84,
      "text": "[เพลง][เสียงร้องเพลง]"
    },
    {
      "id": 288,
      "start": 667.44,
      "end": 672.84,
      "text": "ให้พลิกแผ่นดินไปหาไม่เจอหรอกนะ"
    },
    {
      "id": 289,
      "start": 673.48,
      "end": 677.4,
      "text": "คืออันนี้พอดี"
    },
    {
      "id": 290,
      "start": 675.04,
      "end": 678.76,
      "text": "หรือว่าพี่ปั๊กี้อยากจะลองเต็มเสียง"
    },
    {
      "id": 291,
      "start": 677.4,
      "end": 679.64,
      "text": "ลองก็ได้ครับ"
    },
    {
      "id": 292,
      "start": 678.76,
      "end": 680.08,
      "text": "ลองดีกว่าเดี๋"
    },
    {
      "id": 293,
      "start": 679.64,
      "end": 681.04,
      "text": "ได้เลยครับ"
    },
    {
      "id": 294,
      "start": 680.08,
      "end": 682.76,
      "text": "ลองลองเจาะหน้า"
    },
    {
      "id": 295,
      "start": 681.04,
      "end": 683.6,
      "text": "ไม่งั้นก็เจาะเลยก็ได้แต่ว่าอาจจะต้องลอง"
    },
    {
      "id": 296,
      "start": 682.76,
      "end": 685.84,
      "text": "ที่คำว่า"
    },
    {
      "id": 297,
      "start": 683.6,
      "end": 687.28,
      "text": "ไม่เจอหรอกนะใคร"
    },
    {
      "id": 298,
      "start": 685.84,
      "end": 689.16,
      "text": "ร้องตั้งแต่ไม่เจอเลยก็ได้ครับ"
    },
    {
      "id": 299,
      "start": 687.28,
      "end": 694.28,
      "text": "ได้ครับ"
    },
    {
      "id": 300,
      "start": 689.16,
      "end": 694.28,
      "text": "ไปหาไม่เจอหรอกนะใคร"
    },
    {
      "id": 301,
      "start": 694.48,
      "end": 702.17,
      "text": "ใช้มือช่วยก็ได้แบบใคร่อะไรเงี้ยมันจะไป"
    },
    {
      "id": 302,
      "start": 698.0,
      "end": 705.44,
      "text": "พุ่งขึ้นไปให้ดินไปเหอะไม่เธอหรอกนะ"
    },
    {
      "id": 303,
      "start": 702.17,
      "end": 705.44,
      "text": "[เพลง][เสียงร้องเพลง]ใคร"
    },
    {
      "id": 304,
      "start": 706.04,
      "end": 710.96,
      "text": "ได้มั้ยหน้าใครดี"
    },
    {
      "id": 305,
      "start": 709.04,
      "end": 712.28,
      "text": "ใช่มันเป็นแบบได้"
    },
    {
      "id": 306,
      "start": 710.96,
      "end": 715.12,
      "text": "อ[เสียงหัวเราะ]"
    },
    {
      "id": 307,
      "start": 712.28,
      "end": 717.96,
      "text": "สำหรับสายร้องอย่างเรานะครับและเต้นนิด"
    },
    {
      "id": 308,
      "start": 715.12,
      "end": 721.28,
      "text": "หน่อยก็อาจจะไปรอในส่วนของเต้นหรือเปล่า"
    },
    {
      "id": 309,
      "start": 717.96,
      "end": 724.64,
      "text": "เพราะว่าดูจากเพลงแล้วเนี่ยน่าจะต้องเต้น"
    },
    {
      "id": 310,
      "start": 721.28,
      "end": 727.56,
      "text": "ยับเต้นยับเต้นยับเต้นน่ะเบดแดนซ์น่ะกิน"
    },
    {
      "id": 311,
      "start": 724.64,
      "end": 729.76,
      "text": "ไปเลยทั้งเพลงครึ่งเพลงผมว่ามีความมัน"
    },
    {
      "id": 312,
      "start": 727.56,
      "end": 731.76,
      "text": "ขึ้นเพราะว่าเพซessอ่ะปกติมันอยู่แล้วแต่"
    },
    {
      "id": 313,
      "start": 729.76,
      "end": 736.28,
      "text": "ว่าอันเนี้เป็นความมันแบบตะโกน"
    },
    {
      "id": 314,
      "start": 731.76,
      "end": 739.56,
      "text": "ชอบท่อนท่อนเล็บที่แบบว่าต่อๆจากแบบว่า"
    },
    {
      "id": 315,
      "start": 736.28,
      "end": 742.08,
      "text": "พี่จั๋งไล่มาแล้วก็ปาล์มแล้วก็ผมต่อเป็น"
    },
    {
      "id": 316,
      "start": 739.56,
      "end": 745.4,
      "text": "ท่อนที่แบบว่าต่อกันแบบสมูทมากแล้วก็เท่"
    },
    {
      "id": 317,
      "start": 742.08,
      "end": 750.16,
      "text": "มากแบบจังหวะแลบหรือว่าแบบเอ่อลมแรปมัน"
    },
    {
      "id": 318,
      "start": 745.4,
      "end": 750.16,
      "text": "แบบเปลี่ยนไปทุกช่วงเลยครับ"
    },
    {
      "id": 319,
      "start": 750.64,
      "end": 752.66,
      "text": "[เพลง]"
    },
    {
      "id": 320,
      "start": 753.28,
      "end": 759.12,
      "text": "ผมอึดถึงคนดู[เพลง]ไม่แพ้"
    },
    {
      "id": 321,
      "start": 759.52,
      "end": 764.36,
      "text": "พูดถึงเพลงนี้แข่งกันเรื่องความรักสกิล"
    },
    {
      "id": 322,
      "start": 761.52,
      "end": 766.8,
      "text": "ไหนที่เก่งที่สุดเด่นที่สุดเนี่ยผมว่า"
    },
    {
      "id": 323,
      "start": 764.36,
      "end": 770.68,
      "text": "เรื่องการเทคแหมผมว่าผมแบบค่อนข้าง"
    },
    {
      "id": 324,
      "start": 766.8,
      "end": 776.76,
      "text": "เซอร์วิสดีบริการถึงแก้มจุ่มไม่เธอชิมนี่"
    },
    {
      "id": 325,
      "start": 770.68,
      "end": 777.92,
      "text": "โหสกิลความง่ายเพราะว่าผมกินง่ายอยู่ง่าย"
    },
    {
      "id": 326,
      "start": 776.76,
      "end": 781.44,
      "text": "เลี้ยงง่ายฮะ"
    },
    {
      "id": 327,
      "start": 777.92,
      "end": 784.28,
      "text": "มีเงินรวยโสดครับ"
    },
    {
      "id": 328,
      "start": 781.44,
      "end": 787.16,
      "text": "หน้าตาหรือเปล่าคนที่ได้ควงเราเนี่ยบอก"
    },
    {
      "id": 329,
      "start": 784.28,
      "end": 789.6,
      "text": "เลยว่าไม่ต้องอายใครนะครับหรือไม่ว่าจะ"
    },
    {
      "id": 330,
      "start": 787.16,
      "end": 795.8,
      "text": "เป็นลีลาการเต้นลีลาการเต้นที่ไม่แพ้ใคร"
    },
    {
      "id": 331,
      "start": 789.6,
      "end": 795.8,
      "text": "แน่นอนสกิลเด็ดเหรอรอยิ้มแล้วได้"
    },
    {
      "id": 332,
      "start": 797.36,
      "end": 803.56,
      "text": "ถ้าได้เป็นแฟนผมหรอได้ปีนผ่าทุกวันครับ"
    },
    {
      "id": 333,
      "start": 800.52,
      "end": 806.44,
      "text": "ได้ออกกำลังกายครับถ้าได้เป็นแฟนผมแล้วจะ"
    },
    {
      "id": 334,
