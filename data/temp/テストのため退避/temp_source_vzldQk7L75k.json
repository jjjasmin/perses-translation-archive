    {
      "id": 40,
      "start": 97.56,
      "end": 102.84,
      "text": "ระเบียงบ้านข้างบนแล้วพอเรามองไปที่สนาม"
    },
    {
      "id": 41,
      "start": 100.12,
      "end": 103.4,
      "text": "หญ้าเห็นรูปพี่คนนั้นน่ะปัจจยานกลับบ้าน"
    },
    {
      "id": 42,
      "start": 102.84,
      "end": 105.92,
      "text": "[เพลง]"
    },
    {
      "id": 43,
      "start": 103.4,
      "end": 110.16,
      "text": "ปั่นจักรยานเปิ้งไปแล้วอ่ะเอ้าทำไมเ้า"
    },
    {
      "id": 44,
      "start": 105.92,
      "end": 112.56,
      "text": "กลับแล้วอ่ะเปิ้งสักพักเเดินมาข้างหลัง"
    },
    {
      "id": 45,
      "start": 110.16,
      "end": 114.68,
      "text": "ให้คนหาอยู่ไหนทำไมแบบไม่มาหาสักทีปึ้ง"
    },
    {
      "id": 46,
      "start": 112.56,
      "end": 117.08,
      "text": "คือเขายังไม่ได้ขับจากยากลับบ้านแต่เขา้า"
    },
    {
      "id": 47,
      "start": 114.68,
      "end": 119.08,
      "text": "อ่ะแอบอยู่แล้วเดินมาหาเราว่าทำไมคนหาไป"
    },
    {
      "id": 48,
      "start": 117.08,
      "end": 122.64,
      "text": "คือคนหาอยู่ข้างล่างไม่ได้เดินมาชั้นบน"
    },
    {
      "id": 49,
      "start": 119.08,
      "end": 124.8,
      "text": "แต่เขาเดินมาหาผมว่าทำไมคนหายไม่มาสิเอ้า"
    },
    {
      "id": 50,
      "start": 122.64,
      "end": 126.72,
      "text": "แล้วไม่ได้เปิดจากการกลับไปแล้วแต่ว่าตัว"
    },
    {
      "id": 51,
      "start": 124.8,
      "end": 129.76,
      "text": "นี้ไม่น่ากลัวไงแต่แบบเป็นเรื่องที่จำว่า"
    },
    {
      "id": 52,
      "start": 126.72,
      "end": 131.92,
      "text": "เฮ้ยเค้าขับจากยากลับกันไปแล้วฟิวนี้เออ"
    },
    {
      "id": 53,
      "start": 129.76,
      "end": 134.12,
      "text": "จะเอาอีกมั้ยล่ะเรื่องเจ็บตัวมีเยอะเลยมี"
    },
    {
      "id": 54,
      "start": 131.92,
      "end": 136.36,
      "text": "แบบว่าเกือบตายอะไรอย่างเงี้ยก็เล่นซ่อน"
    },
    {
      "id": 55,
      "start": 134.12,
      "end": 137.76,
      "text": "แอบอีกแล้วแต่ว่าเราอ่ะไปเล่นในแบบบ้าน"
    },
    {
      "id": 56,
      "start": 136.36,
      "end": 139.72,
      "text": "ที่กำลังก่อสร้างอยู่อะไรอย่างเงี้ยแล้ว"
    },
    {
      "id": 57,
      "start": 137.76,
      "end": 141.36,
      "text": "ทีนี้เรากำลังเดินขึ้นมาเป็นไดปูแล้วข้าง"
    },
    {
      "id": 58,
      "start": 139.72,
      "end": 143.28,
      "text": "ล่างมันก็จะมีแบบเตอกเสาเข็มเอาไว้แบบ"
    },
    {
      "id": 59,
      "start": 141.36,
      "end": 145.64,
      "text": "เนี้ยเสร็จแล้วเราก็เฮ้ยเคยรอบเดียวในราย"
    },
    {
      "id": 60,
      "start": 143.28,
      "end": 147.92,
      "text": "การนี่หว่ากตันทนight"
    },
    {
      "id": 61,
      "start": 145.64,
      "end": 150.0,
      "text": "เป็นเรื่องที่สมัยก่อนผมอยู่ขอนแก่นใช่"
    },
    {
      "id": 62,
      "start": 147.92,
      "end": 152.24,
      "text": "มั้ครับเป็นเด็กขอนแก่นแล้วผมก็จะอยู่ใน"
    },
    {
      "id": 63,
      "start": 150.0,
      "end": 155.2,
      "text": "หมู่บ้านหมู่บ้านนึงที่มันเย็นๆมาปุ๊บ"
    },
    {
      "id": 64,
      "start": 152.24,
      "end": 158.44,
      "text": "เนี่ยเด็กๆก็จะรวมกลุ่มกันเป็นแก๊ง"
    },
    {
      "id": 65,
      "start": 155.2,
      "end": 162.8,
      "text": "จักรยานออกไปขับรถเล่นดิฟอะไรอย่างี้กัน"
    },
    {
      "id": 66,
      "start": 158.44,
      "end": 165.28,
      "text": "ใช่มั้ยครับแล้ววันนึงอะไรอย่างงี้ผมก็"
    },
    {
      "id": 67,
      "start": 162.8,
      "end": 168.08,
      "text": "ปั่นจักรยานไปแล้วมันมีหมาที่บ้านนึงน่า"
    },
    {
      "id": 68,
      "start": 165.28,
      "end": 171.32,
      "text": "รักมากผมก็เลยอยากเข้าไปเล่นกับมันโดยการ"
    },
    {
      "id": 69,
      "start": 168.08,
      "end": 174.36,
      "text": "ที่ปีนรั้วบ้านเค้าขึ้นไปเลยนะครับปีน"
    },
    {
      "id": 70,
      "start": 171.32,
      "end": 176.04,
      "text": "รั้วบ้านเ้าขึ้นไปซึ่งไม่ควรทำนะครับแต่"
    },
    {
      "id": 71,
      "start": 174.36,
      "end": 178.24,
      "text": "คือเราจะไม่ได้ไม่ได้จะกระโดดเข้าไปใน"
    },
    {
      "id": 72,
      "start": 176.04,
      "end": 180.52,
      "text": "บ้านเค้าแต่เราแค่เหมือนแบบอยากเข้าใกล้"
    },
    {
      "id": 73,
      "start": 178.24,
      "end": 182.68,
      "text": "หมามากขึ้นอะไรอย่างงี้แล้วมันก็มีจังหวะ"
    },
    {
      "id": 74,
      "start": 180.52,
      "end": 185.68,
      "text": "ที่จากที่มันน่ารักเนี่ยพอมันเห็นว่าเรา"
    },
    {
      "id": 75,
      "start": 182.68,
      "end": 188.68,
      "text": "ลุกลำพื้นที่ปุ๊บมันทำท่าเหมือนจะกัดผมก็"
    },
    {
      "id": 76,
      "start": 185.68,
      "end": 191.56,
      "text": "เลยตกใจมากแล้วก็รีบกระโดดลงมาจากกำแพง"
    },
    {
      "id": 77,
      "start": 188.68,
      "end": 194.2,
      "text": "แล้วก็ล้มใส่จักรยานตัวเองนะครับเพื่อน"
    },
    {
      "id": 78,
      "start": 191.56,
      "end": 197.12,
      "text": "อีกคนไม่เป็นไรเลยแต่ผมล้มใส่จักรยานทำ"
    },
    {
      "id": 79,
      "start": 194.2,
      "end": 199.8,
      "text": "ให้กระดูกนิ้วก้อยข้างซ้ายเนี่ยร้าวนะ"
    },
    {
      "id": 80,
      "start": 197.12,
      "end": 202.96,
      "text": "ครับผมไปหาหมอปุ๊บคุณหมอก็ให้ใส่เฝือก"
    },
    {
      "id": 81,
      "start": 199.8,
      "end": 205.04,
      "text": "อ่อนแล้วก็บอกว่าต้องกายภาพนะต้องคอยดัด"
    },
    {
      "id": 82,
      "start": 202.96,
      "end": 206.64,
      "text": "มันทุกวันเพราะว่าเวลาอยู่ในเฝือกอ่ะมัน"
    },
    {
      "id": 83,
      "start": 205.04,
      "end": 209.32,
      "text": "จะเป็นอย่างี้ใช่มั้ครับแล้วเพราะว่านิ้ว"
    },
    {
      "id": 84,
      "start": 206.64,
      "end": 211.76,
      "text": "เราตรงไม่ได้แล้วเก็จะให้เราเนี่ยดัดๆ"
    },
    {
      "id": 85,
      "start": 209.32,
      "end": 214.12,
      "text": "ถ้วนแต่ผมอ่ะไม่ทำเพราะว่ามันเจ็บนิ้วผม"
    },
    {
      "id": 86,
      "start": 211.76,
      "end": 217.04,
      "text": "ก็เลยเป็นแบบนี้เลยนะครับอันนี้คือนิ้ว"
    },
    {
      "id": 87,
      "start": 214.12,
      "end": 219.4,
      "text": "ปกติอันนี้คือนิ้วที่อันนี้คือยืดสุดแล้ว"
    },
    {
      "id": 88,
      "start": 217.04,
      "end": 221.68,
      "text": "นะครับทุกคนเห็นมว่ามันสุดแล้วสมมุติเวลา"
    },
    {
      "id": 89,
      "start": 219.4,
      "end": 224.6,
      "text": "แบบผมไหว้ใครแล้วนิ้วเป็นอย่างงี้ก็ไม่"
    },
    {
      "id": 90,
      "start": 221.68,
      "end": 227.0,
      "text": "ต้องตกใจนะครับขอบคุณครับ"
    },
    {
      "id": 91,
      "start": 224.6,
      "end": 230.88,
      "text": "มีเหตุการณ์นึงนะครับที่ผมจะไม่เคยลืมก็"
    },
    {
      "id": 92,
      "start": 227.0,
      "end": 233.76,
      "text": "คือช่วงประถมประถมปลายผมก็จะเป็นแบบเออ"
    },
    {
      "id": 93,
      "start": 230.88,
      "end": 235.8,
      "text": "เด็กหลังห้องเตะบอลเนาะแบบช่วงพักเที่ยง"
    },
    {
      "id": 94,
      "start": 233.76,
      "end": 240.16,
      "text": "อะไรอย่างงี้แล้วพอมันมีวันหนึ่งลูกบอล"
    },
    {
      "id": 95,
      "start": 235.8,
      "end": 243.4,
      "text": "หายลูกบอลที่แบบเก็บเอาไว้หายก็เลยทำไงดี"
    },
    {
      "id": 96,
      "start": 240.16,
      "end": 246.64,
      "text": "มองซ้ายมองขวาเจอลูกวอลเลย์วอลเลย์บอล"
    },
    {
      "id": 97,
      "start": 243.4,
      "end": 249.36,
      "text": "ซึ่งครูครูชอบบอกว่าห้ามเอาลูกวอลเลย์บอล"
    },
    {
      "id": 98,
      "start": 246.64,
      "end": 252.24,
      "text": "ไปเตะบอลเพราะว่ามันเป็นกฎของโรงเรียนผม"
    },
    {
      "id": 99,
      "start": 249.36,
      "end": 255.6,
      "text": "ก็เลยแบบเออไหนๆลูกบอลมันไม่มีแล้วเนาะ"
    },
    {
      "id": 100,
      "start": 252.24,
      "end": 260.84,
      "text": "แล้วก็เลยบีบลูกวอลเลย์บอลนี้ไปเตะลงสนาม"
    },
    {
      "id": 101,
      "start": 255.6,
      "end": 266.56,
      "text": "ฟุตบอลเลยไปเตะๆๆๆพอเตะไปเตะมาปี"
    },
    {
      "id": 102,
      "start": 260.84,
      "end": 270.72,
      "text": "เสียงโคนกหวีดแล้วบอกหมอบโง"
    },
    {
      "id": 103,
      "start": 266.56,
      "end": 275.12,
      "text": "ก็เรียกมาเอาลูกบอลเล่บอลไปเตะได้ยังไงจะ"
    },
    {
      "id": 104,
      "start": 270.72,
      "end": 279.16,
      "text": "ทำโทษยิ่งรอบสนาม 3 รอบ"
    },
    {
      "id": 105,
      "start": 275.12,
      "end": 282.8,
      "text": "3 รอบวันนั้นผมโกรธครูมากผมก็เลยคิดไทย"
    },
    {
      "id": 106,
      "start": 279.16,
      "end": 286.12,
      "text": "กับเพื่อนขโมยลูกวอลเลย์บอลผมขโมยไปคนละ"
    },
    {
      "id": 107,
      "start": 282.8,
      "end": 290.0,
      "text": "ลูกกับเพื่อนวันนั้นเอาไปประมาณ 5 ลูก 6"
    },
    {
      "id": 108,
      "start": 286.12,
      "end": 292.36,
      "text": "เอาไปแล้วก็พอกลับบ้านไปก็แบบโอ๊ยรู้สึก"
    },
    {
      "id": 109,
      "start": 290.0,
      "end": 294.68,
      "text": "อยากเป็นคนดีขึ้นมาแล้วไม่อยากทำเรื่อง"
    },
    {
      "id": 110,
      "start": 292.36,
      "end": 298.28,
      "text": "แบบนี้แล้วก็เลยอีกวันนึงก็เลยเอาวอลเลมา"
    },
    {
      "id": 111,
      "start": 294.68,
      "end": 298.28,
      "text": "คืนครูประมาณนี้"
    }
  ]
}