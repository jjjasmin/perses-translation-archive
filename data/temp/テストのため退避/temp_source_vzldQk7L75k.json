    {
      "id": 29,
      "start": 70.6,
      "end": 76.32,
      "text": "แบบพวกเออสมัยนั้นน่ะจำไม่ได้แล้วอ่ะ"
    },
    {
      "id": 30,
      "start": 73.84,
      "end": 78.08,
      "text": "แต่เราไม่ลืมมีอันนึงแต่แบบแอบน่ากลัวนิด"
    },
    {
