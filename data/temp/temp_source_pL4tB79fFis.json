    {
      "id": 115,
      "start": 546.72,
      "end": 551.96,
      "text": "ความหิินผมก็เลยคิดว่าอ๋อมันน่าจะอยู่ใน"
    },
    {
      "id": 116,
      "start": 548.76,
      "end": 554.4,
      "text": "นรก่ะแหละพี่ครับผมขอเป็นดนตรีฟิวแบบว่า"
    },
    {
      "id": 117,
      "start": 551.96,
      "end": 560.28,
      "text": "นรกเอาล่ะ"
    },
    {
      "id": 118,
      "start": 554.4,
      "end": 567.56,
      "text": "ตอ้าอย่างงี้เลยโอเคนะซึ่งคนแรกนะครับพี่"
    },
    {
      "id": 119,
      "start": 560.28,
      "end": 571.48,
      "text": "เนตามเคยสวัสดีครับผมเป็นคนจดบัญชีในนรก"
    },
    {
      "id": 120,
      "start": 567.56,
      "end": 574.28,
      "text": "ครับอ๋อเป็นฟิล์บอกว่าแอบชอบใครก็จดเอา"
    },
    {
      "id": 121,
      "start": 571.48,
      "end": 576.44,
      "text": "ไว้หรอแล้วจะจดไปทั้ง่อเลยป่ะเนี่ยโอ้โห"
    },
    {
      "id": 122,
      "start": 574.28,
      "end": 579.8,
      "text": "เดี๋ยวไปซื้อหนังสือเพิ่มก่อนนะครับผมเออ"
    },
    {
      "id": 123,
      "start": 576.44,
      "end": 581.24,
      "text": "ขอบคุณผมด้วยนะผมโอสา 2 มั้ครับผมในเพซ"
    },
    {
      "id": 124,
      "start": 579.8,
      "end": 584.64,
      "text": "ครับ"
    },
    {
      "id": 125,
      "start": 581.24,
      "end": 590.2,
      "text": "เอ้อต่อไปเลย"
    },
    {
      "id": 126,
      "start": 584.64,
      "end": 592.92,
      "text": "ครับคิดไม่ออกไปเลยไอ้หนูครับเมื่อชาติ"
    },
    {
      "id": 127,
      "start": 590.2,
      "end": 595.2,
      "text": "ที่แล้วผมได้ทำบาปเอาไว้นะครับก็คือตกลุม"
    },
    {
      "id": 128,
      "start": 592.92,
      "end": 601.32,
      "text": "รักแม่ตัวเองนะ"
    },
    {
      "id": 129,
      "start": 595.2,
      "end": 601.32,
      "text": "ครับขอโทษทีนะครับผมปาลมเพรซครับ"
    },
    {
      "id": 130,
      "start": 604.56,
      "end": 614.6,
      "text": "ครับผมเอิ่มวันนี้ผมมาเป็นนางฟ้าครับผม"
    },
    {
      "id": 131,
      "start": 610.08,
      "end": 615.4,
      "text": "เ้าแล้วนรกอ่ะนรกมาเฝ้ารอดูเพื่อนๆตกนรก"
    },
    {
      "id": 132,
      "start": 614.6,
      "end": 618.96,
      "text": "ครับ"
    },
    {
      "id": 133,
      "start": 615.4,
      "end": 622.2,
      "text": "เอ้าแต่วันนี้นางฟ้าไม่ได้มาตกนรกด้วยแต่"
    },
    {
      "id": 134,
      "start": 618.96,
      "end": 622.2,
      "text": "มาตกรุมรักทุกคน"
    },
    {
      "id": 135,
      "start": 622.55,
      "end": 631.48,
      "text": "[เพลง]"
    },
    {
      "id": 136,
      "start": 624.96,
      "end": 636.24,
      "text": "ฮะเออวันนี้มาแบบเบๆพอเพราะว่าว่าผมเป็น"
    },
    {
      "id": 137,
      "start": 631.48,
      "end": 639.0,
      "text": "เด็กชายในนารกครับทำไมรู้มยครับทำไมครับ"
    },
    {
      "id": 138,
      "start": 636.24,
      "end": 643.64,
      "text": "เพราะว่า All  Good  Boys  go  to  Heaven"
    },
    {
      "id": 139,
      "start": 639.0,
      "end": 643.64,
      "text": "but  Bad  Boys  Bring  Heaven  to  you"
    },
    {
      "id": 140,
      "start": 644.44,
      "end": 649.44,
      "text": "ว้า"
    },
    {
      "id": 141,
      "start": 646.16,
      "end": 652.52,
      "text": "เป็นมองหน้ากิจเมื่อกี้ไม่มีอะไรเลยบอก"
    },
    {
      "id": 142,
      "start": 649.44,
      "end": 655.36,
      "text": "ว่าให้แปให้ด้วยแปลให้ด้วยแปลให้ด้วยเอาล"
    },
    {
      "id": 143,
      "start": 652.52,
      "end": 656.84,
      "text": "เอาลอ่ะเเตรียมแล้วเเตรียมแล้วคนนี้"
    },
    {
      "id": 144,
      "start": 655.36,
      "end": 662.2,
      "text": "เตรียมแล้วี"
    },
    {
      "id": 145,
      "start": 656.84,
      "end": 667.28,
      "text": "โเไม่บีเไม่บีไฟแดงๆน่าจะดีมากเลยนะฮะรอ"
    },
    {
      "id": 146,
      "start": 662.2,
      "end": 670.67,
      "text": "ดูเลยครับคนนี้มีใครตรงนี้อยากโดนผมลงโทษ"
    },
    {
      "id": 147,
      "start": 667.28,
      "end": 673.95,
      "text": "ด้วยการโดนผมรักมย"
    },
    {
      "id": 148,
      "start": 670.67,
      "end": 673.95,
      "text": "[ปรบมือ]"
    },
    {
      "id": 149,
      "start": 677.56,
      "end": 686.52,
      "text": "ครับครับผมตามเคยนะฮะจบไปแล้วสำหรับช่วง"
    },
    {
      "id": 150,
      "start": 681.4,
      "end": 686.52,
      "text": "ถวงเวลาให้หายเหนื่อยนะครับผมิิเเซครับ"
    },
    {
      "id": 151,
      "start": 687.08,
      "end": 693.24,
      "text": "เฮ้โห"
    },
    {
      "id": 152,
      "start": 689.68,
      "end": 697.88,
      "text": "เมื่อกี้เมื่อกี้ผมพูดชื่อไปหรือยังนะยัง"
    },
    {
      "id": 153,
      "start": 693.24,
      "end": 703.8,
      "text": "ใช่ป่ะสวัสดีครับปักกี้เพซนะคะ"
    },
    {
      "id": 154,
      "start": 697.88,
      "end": 706.76,
      "text": "วโอเคน่ารักสดโอเคโอเคครบทุกคนแล้วเพลง"
    },
    {
      "id": 155,
      "start": 703.8,
      "end": 708.96,
      "text": "ต่อไปเนี่ยครับผมอาฮะสำหรับคนที่กำลัง"
    },
    {
      "id": 156,
      "start": 706.76,
      "end": 712.28,
      "text": "เหมือนตกนรกทั้งเป็น"
    },
    {
      "id": 157,
      "start": 708.96,
      "end": 714.88,
      "text": "เ้ยคนที่พยายามฝืนตัวเองอยู่ในความ"
    },
    {
      "id": 158,
      "start": 712.28,
      "end": 719.56,
      "text": "สัมพันธ์ที่รู้ว่าไปต่อไม่ได้ลองฟัง"
    },
    {
      "id": 159,
      "start": 714.88,
      "end": 727.64,
      "text": "เพลงนี้พเราดูครับอย่าฝืนครับผมไป"
    },
    {
      "id": 160,
      "start": 719.56,
      "end": 737.08,
      "text": "ได้โปรดเลยอย่าฝืนเธอลไปกันไปว้ให้มันจบง"
    },
    {
      "id": 161,
      "start": 727.64,
      "end": 744.04,
      "text": "นี้คงดีกว่าต้องเิมืนใช่ากจะรปล่อยให้น้ก"
    },
    {
      "id": 162,
      "start": 737.08,
      "end": 744.04,
      "text": "หลไปไม่รู้ว่าจะฝืนทำไม"
    },
    {
      "id": 163,
      "start": 749.45,
      "end": 764.38,
      "text": "[เพลง]"
    },
    {
      "id": 164,
      "start": 766.32,
      "end": 779.72,
      "text": "หากเธอจนไวไให้วังเอาไว้จะเลงก"
    },
    {
      "id": 165,
      "start": 773.12,
      "end": 781.2,
      "text": "ไปเียมหัวใจไม่สักหน่อยไปคุณจะไม่ปลอดไย"
    },
    {
      "id": 166,
      "start": 779.72,
      "end": 785.36,
      "text": "จะกพาม"
    },
    {
      "id": 167,
      "start": 781.2,
      "end": 788.07,
      "text": "ไมาเข้ามาก็ขอเจอ"
    },
    {
      "id": 168,
      "start": 785.36,
      "end": 793.68,
      "text": "ได้เ"
    },
    {
      "id": 169,
      "start": 788.07,
      "end": 804.39,
      "text": "[ปรบมือ]"
    },
    {
      "id": 170,
      "start": 793.68,
      "end": 804.39,
      "text": "[เพลง]"
    },
    {
      "id": 171,
      "start": 809.24,
      "end": 823.44,
      "text": "หัวเอไหล่เอเอตูดหัวไหล่ตูดหัวไหล่ตูดหัว"
    },
    {
      "id": 172,
      "start": 817.0,
      "end": 832.2,
      "text": "ไล่ตูดหัวไหล่ตูดตูๆๆโอโที่ิจะหัวเวๆจก"
    },
    {
      "id": 173,
      "start": 823.44,
      "end": 832.2,
      "text": "ผัวไม่แตกเหนือต้องตัวหัวไล่ตูดตูดตดตด"
    },
    {
      "id": 174,
      "start": 833.72,
      "end": 841.04,
      "text": "ๆยยระตักครับพเนน่ารักยยๆสผักชให้ผมรัก"
    },
    {
      "id": 175,
      "start": 841.05,
      "end": 860.12,
      "text": "[เพลง]"
    },
    {
      "id": 176,
      "start": 851.36,
      "end": 865.16,
      "text": "ลงในใจฉันเป็นแบบนี้ฉันว่าจะมีกใช้ไหมใจ"
    },
    {
      "id": 177,
      "start": 860.12,
      "end": 867.32,
      "text": "มันเตมมันเป็นเป็นจังหวมาแล้วเธอล่ะอา"
    },
    {
      "id": 178,
      "start": 865.16,
      "end": 871.6,
      "text": "เป็นจังหวะยัง"
    },
    {
      "id": 179,
      "start": 867.32,
      "end": 877.68,
      "text": "ไงขอเสียแฟนจ๋าหน่อย"
    },
    {
      "id": 180,
      "start": 871.6,
      "end": 883.52,
      "text": "แล้วแฟนจ๋าฉันมาแล้วจ้ะมีแล้วนให้เยบมา"
    },
    {
      "id": 181,
      "start": 877.68,
      "end": 884.8,
      "text": "ใกล้ๆลวาจต้องเป็นเนืคู่รักที่ไม่อู้องค์"
    },
    {
      "id": 182,
      "start": 883.52,
      "end": 891.16,
      "text": "แม่ยอด"
    },
    {
      "id": 183,
      "start": 884.8,
      "end": 896.48,
      "text": "ชาจ๊ฉันมาแล้วจ๊ะอยู่ดีแล้วนะขยิบมาใกล้ๆ"
    },
    {
      "id": 184,
      "start": 891.16,
      "end": 903.32,
      "text": "ลวาจ๊เราเป็นเหนือคู่รักจริไม่อูโอ้แม่"
    },
    {
      "id": 185,
      "start": 896.48,
      "end": 912.44,
      "text": "ยอดชฉันไม่ได้อยากแล้วไม่อยากทำอย่างนี้"
    },
    {
      "id": 186,
      "start": 903.32,
      "end": 912.44,
      "text": "มันืจริงๆกพ่อรู้ก็ดีเได้ษทีที่ฉันทำ"
    },
    {
      "id": 187,
      "start": 912.72,
      "end": 922.04,
      "text": "ไปเป็นจังได๋ล่ะน้องความฮักเป็นจังได๋ล่ะ"
    },
    {
      "id": 188,
      "start": 917.04,
      "end": 926.2,
      "text": "นาความฮักที่เคยหอเคยกอดคิดฮอดอย่าหนาหัว"
    },
    {
      "id": 189,
      "start": 922.04,
      "end": 930.72,
      "text": "ใจสัญญาไวสิมามันมาหยไลพันปาให้ป่าลุมค่า"
    },
    {
      "id": 190,
      "start": 926.2,
      "end": 935.32,
      "text": "และลอยบอกให้คอยยังจำได้บ่คำสัญญายังจำ"
    },
    {
      "id": 191,
      "start": 930.72,
      "end": 941.84,
      "text": "ได้บ่บ่อเจ็บใจข่าบ่ถอยคิดฮอเดอความฮัก"
    },
    {
      "id": 192,
      "start": 935.32,
      "end": 952.4,
      "text": "แท้ปานี้อยู่ใสแลอยากคิดถึงเธอ"
    },
    {
      "id": 193,
      "start": 941.84,
      "end": 959.75,
      "text": "รักวันนี้ไม่มีเธอเหแดโลกนี้ฉันดูักอออุม"
    },
    {
      "id": 194,
      "start": 952.4,
      "end": 962.48,
      "text": "ทะเลขอฟแสนใเพเธอได้ไม่ยมค"
    },
    {
      "id": 195,
      "start": 959.75,
      "end": 965.48,
      "text": "[ปรบมือ]"
    },
    {
      "id": 196,
      "start": 962.48,
      "end": 965.48,
      "text": "คิม"
    },
    {
      "id": 197,
      "start": 968.32,
      "end": 973.28,
      "text": "ิดเข้าตัวคือตัวฉันต้อง"
    },
    {
      "id": 198,
      "start": 975.41,
      "end": 978.61,
      "text": "[ปรบมือ]"
    },
    {
      "id": 199,
      "start": 980.8,
      "end": 988.4,
      "text": "ม่ขอเสียงคนอยากดูโโยตี้หน่อยเร"
    },
    {
      "id": 200,
      "start": 985.08,
      "end": 988.4,
      "text": "[ปรบมือ]"
    },
    {
      "id": 201,
      "start": 990.44,
      "end": 1001.28,
      "text": "มารเข้ามามาดูขอโยตี้บนรถปิกอัไหนคุณพี่"
    },
    {
      "id": 202,
      "start": 996.44,
      "end": 1006.0,
      "text": "เซ็กซี่มาออยู่ข้างบนรถยนต์ดีิกามทุกคน"
    },
    {
      "id": 203,
      "start": 1001.28,
      "end": 1010.72,
      "text": "มากมายสวัสดีจ้าเอิสวัสดีจ้าูสวัสดีจ้ะ"
    },
    {
      "id": 204,
      "start": 1006.0,
      "end": 1014.0,
      "text": "พี่เศวันนี้เรามีสาวสวยคนนึงมาหาเธอนะจ๊ะ"
    },
    {
      "id": 205,
      "start": 1010.72,
      "end": 1017.48,
      "text": "วันนี้ขาพเป็นยอกแยเหมือนเดิมน้อง"
    },
    {
      "id": 206,
      "start": 1014.0,
      "end": 1021.52,
      "text": "ักิเดินเข้ามาเมื่อกี้พี่เห็นดูยิ้มจะ"
    },
    {
      "id": 207,
      "start": 1017.48,
      "end": 1028.44,
      "text": "จิ้มเฉยหน้าตดีแต่เจอกบ่ได้"
    },
    {
      "id": 208,
      "start": 1021.52,
      "end": 1028.44,
      "text": "เด้อไปนัไปบ้าเขหน้าตแต่งแต่ง"
    },
    {
      "id": 209,
      "start": 1028.65,
      "end": 1032.27,
      "text": "[เพลง]"
    },
    {
      "id": 210,
      "start": 1032.48,
      "end": 1039.2,
      "text": "แตทุกคนสนุกกันไ"
    },
    {
      "id": 211,
      "start": 1035.24,
      "end": 1044.0,
      "text": "ครับไหนมีใครได้ดูอย่าฝันไ"
    },
    {
      "id": 212,
      "start": 1039.2,
      "end": 1045.88,
      "text": "สอดูกันเยอะเหมือนกันนะอยังมีบางคแก่ะมัน"
    },
    {
      "id": 213,
      "start": 1044.0,
      "end": 1049.68,
      "text": "ไม่เหมาะสมอยู่ที่นี่"
    },
    {
      "id": 214,
      "start": 1045.88,
      "end": 1053.0,
      "text": "หรอกแกมาชั้นจี"
    },
    {
      "id": 215,
      "start": 1049.68,
      "end": 1055.88,
      "text": "ไปด้วยกว่าแม่แล้วจะบอกให้นะว่าฉันจีบแปล"
    },
    {
      "id": 216,
      "start": 1053.0,
      "end": 1059.64,
      "text": "ว่าอะไรแปลว่าอะไร"
    },
    {
      "id": 217,
      "start": 1055.88,
      "end": 1059.64,
      "text": "คะฉัน"
    },
    {
      "id": 218,
      "start": 1061.16,
      "end": 1070.04,
      "text": "ต่ำอุ้ยใช่มยจ๊ะปารตีใช่เลยคุณหญิงย่าปาก"
    },
    {
      "id": 219,
      "start": 1067.72,
      "end": 1073.08,
      "text": "ดีมิส"
    },
    {
      "id": 220,
      "start": 1070.04,
      "end": 1075.16,
      "text": "แกนเมื่อกี้จริงๆก่อนขึ้นเวทีเรามีการคุย"
    },
    {
      "id": 221,
      "start": 1073.08,
      "end": 1077.16,
      "text": "สิปกันแล้วพี่จังก็บอกว่าเอ้ยเราเอาละคร"
    },
    {
      "id": 222,
      "start": 1075.16,
      "end": 1079.24,
      "text": "สัเราไปเล่นบนเวทีมั้ยพี่กิจบอกว่าไม่"
