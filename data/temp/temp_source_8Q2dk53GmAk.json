      "start": 781.84,
      "end": 786.48,
      "text": "ว่ารู้ว่าคิดไม่ซื่ออ่ะเออใช่ๆมีมีความ"
    },
    {
      "id": 334,
      "start": 784.64,
      "end": 786.76,
      "text": "แบบคิดไม่ซื่ออยู่ในเสียงนำเสียงอยู่แล้ว"
    },
    {
      "id": 335,
      "start": 786.48,
      "end": 789.08,
      "text": "อ่ะ"
    },
    {
      "id": 336,
      "start": 786.76,
      "end": 791.56,
      "text": "ปามนี้เรียกได้ว่าม้ามืดไม่รู้ว่าเป็นตัว"
    },
    {
      "id": 337,
      "start": 789.08,
      "end": 794.6,
      "text": "ตนที่ซ่อนอยู่หรือว่าอะไรแต่ว่ารู้สึกว่า"
    },
    {
      "id": 338,
      "start": 791.56,
      "end": 797.24,
      "text": "มันเป็นเซตโทนเสียงและอารมณ์ที่เข้ากับ"
    },
    {
      "id": 339,
      "start": 794.6,
      "end": 800.04,
      "text": "โจทย์เพลงได้ดีที่สุดอะไรอย่างเงี้ยค่ะ"
    },
    {
      "id": 340,
      "start": 797.24,
      "end": 802.48,
      "text": "รู้สึกว่าเฮ้ยฟังแล้วแบบบ้าเอ้ยหยุดยิ้ม"
    },
    {
      "id": 341,
      "start": 800.04,
      "end": 805.52,
      "text": "ไม่ได้เลยอย่านะอะไรเป็นฟิลประมาณเนี้ย"
    },
    {
      "id": 342,
      "start": 802.48,
      "end": 807.92,
      "text": "แบบว่าคิดว่าน่าจะเป็นด้านใหม่ๆของน้อง"
    },
    {
      "id": 343,
      "start": 805.52,
      "end": 811.2,
      "text": "ที่อาจจะไม่เคยมีใครเห็นเหมือนกันรู้สึก"
    },
    {
      "id": 344,
      "start": 807.92,
      "end": 812.48,
      "text": "ว่าเฮ้ยแนวนี้เข้าต่อไปทำเพลงแนวนี้ปาม"
    },
    {
      "id": 345,
      "start": 811.2,
      "end": 815.88,
      "text": "เป็นเฮสได้เลย"
    },
    {
      "id": 346,
      "start": 812.48,
      "end": 818.64,
      "text": "เออจริงๆทนเสียงครับทนเสียงเฉยๆครับ"
    },
    {
      "id": 347,
      "start": 815.88,
      "end": 820.92,
      "text": "ปกติเป็นคนเรียบร้อยครับโตยังคะสนุก"
    },
    {
      "id": 348,
      "start": 818.64,
      "end": 823.24,
      "text": "โตแล้วครับ"
    },
    {
      "id": 349,
      "start": 820.92,
      "end": 825.0,
      "text": "อัดไปแล้วจักจี้ตัวเองไปเมื่อกี้"
    },
    {
      "id": 350,
      "start": 823.24,
      "end": 827.96,
      "text": "ผมคิดว่าน่าจะเป็นโทนเสียงมั้งครับโทน"
    },
    {
      "id": 351,
      "start": 825.0,
      "end": 830.16,
      "text": "เสียงผมแบบอาจจะแบบเหนื่อยๆมันก็เลยแบบ"
    },
    {
      "id": 352,
      "start": 827.96,
      "end": 832.84,
      "text": "เหมาะกับเพลงนี้มันเลยมีความแบบเซ็กซี่"
    },
    {
      "id": 353,
      "start": 830.16,
      "end": 834.76,
      "text": "อะไรอย่างงี้บ้างครับขอบคุณจับนะ"
    },
    {
      "id": 354,
      "start": 832.84,
      "end": 837.92,
      "text": "เออ"
    },
    {
      "id": 355,
      "start": 834.76,
      "end": 839.4,
      "text": "คือตอนอัดไปร้องร้องไปแล้ว"
    },
    {
      "id": 356,
      "start": 837.92,
      "end": 842.16,
      "text": "จักกจี้ตัวเองปับ"
    },
    {
      "id": 357,
      "start": 839.4,
      "end": 845.08,
      "text": "ใครเจอเธอก็ถึงกับติดกับดักตัวเธอนั้นมี"
    },
    {
      "id": 358,
      "start": 842.16,
      "end": 848.0,
      "text": "ความผิดคืนนี้ผมไม่ให้กลับห้ามจะขยับให้"
    },
    {
      "id": 359,
      "start": 845.08,
      "end": 851.8,
      "text": "ผมจับสตีเจถ้าไม่อยากจะกลับยอมให้จับดู"
    },
    {
      "id": 360,
      "start": 848.0,
      "end": 853.84,
      "text": "นี้ฟรีห้ามจะขยับมาให้จับสตีจับตรงนี้จับ"
    },
    {
      "id": 361,
      "start": 851.8,
      "end": 855.72,
      "text": "ตรงนั้นมันจะไอ้นี่มันจะไอ้นั่นห้ามจะ"
    },
    {
      "id": 362,
      "start": 853.84,
      "end": 856.56,
      "text": "ขยับให้ผมจับสดี"
    },
    {
      "id": 363,
      "start": 855.72,
      "end": 858.08,
      "text": "เธอไม่อยากจะตับ"
    },
    {
      "id": 364,
      "start": 856.56,
      "end": 859.0,
      "text": "ยอนไม่จับอยู่นี้ฟรี"
    },
    {
      "id": 365,
      "start": 858.08,
      "end": 861.52,
      "text": "ห้ามจะขยับ"
    },
    {
      "id": 366,
      "start": 859.0,
      "end": 864.2,
      "text": "ไม่จับสักทีจับตรงนี้สุดตรงนั้น"
    },
    {
      "id": 367,
      "start": 861.52,
      "end": 868.84,
      "text": "มันจะไอ้นี่มันจะไอ้นั่นน่ะจับจับจับ"
    },
    {
      "id": 368,
      "start": 864.2,
      "end": 871.36,
      "text": "ขอผมจับนะมยหมับไป"
    },
    {
      "id": 369,
      "start": 868.84,
      "end": 872.28,
      "text": "ขอจับนะจับตรงนี้จับตรงนั้นมันจะไอ้นี่"
    },
    {
      "id": 370,
      "start": 871.36,
      "end": 874.84,
      "text": "มันไอ้นั่นน่ะ"
    },
    {
      "id": 371,
      "start": 872.28,
      "end": 877.24,
      "text": "เราว่าสำหรับเอ่อทีมที่ทำเพลงเนี่ยเราก็"
    },
    {
      "id": 372,
      "start": 874.84,
      "end": 880.0,
      "text": "คงจะตื่นเต้นกับท่าเต้นของเพลงนี้เพราะ"
    },
    {
      "id": 373,
      "start": 877.24,
      "end": 882.08,
      "text": "ว่าเอาจริงๆเพลงเนี้ยกิมิกมันเยอะมากทั้ง"
    },
    {
      "id": 374,
      "start": 880.0,
      "end": 884.04,
      "text": "แบบว่าท่อนแต่ละอย่างหรือคำแต่ละอย่างที่"
    },
    {
      "id": 375,
      "start": 882.08,
      "end": 886.44,
      "text": "เราไม่คิดว่ามันจะได้ใส่ในเพลงเนี้ยมันก็"
    },
    {
      "id": 376,
      "start": 884.04,
      "end": 888.64,
      "text": "ออกมาด้วยก็เลยรู้สึกว่าอยากรอดูท่าเต้น"
    },
    {
      "id": 377,
      "start": 886.44,
      "end": 893.16,
      "text": "อยากรอดูเพอร์ฟอร์มของน้องๆบนเวทีครับ"
    },
    {
      "id": 378,
      "start": 888.64,
      "end": 895.52,
      "text": "เพลงนี้เป็นเพลงแรกที่ได้แบบว่าลงเมโลดี้"
    },
    {
      "id": 379,
      "start": 893.16,
      "end": 898.0,
      "text": "แล้วก็ช่วยเรื่องคอนเซปแล้วก็คิดเลยจาก"
    },
    {
      "id": 380,
      "start": 895.52,
      "end": 900.84,
      "text": "ที่ปกติแต่งเนื้อเพลงอย่างเดียวรู้สึกว่า"
    },
    {
      "id": 381,
      "start": 898.0,
      "end": 904.32,
      "text": "สนุกมากเลยค่ะแล้วก็น้องๆเนี่ยแบบว่าชาย"
    },
    {
      "id": 382,
      "start": 900.84,
      "end": 907.92,
      "text": "อย่างเต็มที่จริงๆอยากให้ลองมาค้นพบสิ่ง"
    },
    {
      "id": 383,
      "start": 904.32,
      "end": 910.28,
      "text": "นี้กันดูว่าหัวแถวมันเป็นยังไง"
    },
    {
      "id": 384,
      "start": 907.92,
      "end": 912.52,
      "text": "ไปรอดูว่าเขาจะจับกันตรงไหนกันเยอะๆนะ"
    },
    {
      "id": 385,
      "start": 910.28,
      "end": 915.2,
      "text": "ครับผมว่าจับกันสนุกแน่นอนเพลงเนี้ย"
    },
    {
      "id": 386,
      "start": 912.52,
      "end": 918.56,
      "text": "ฝากติดตามเพลงนี้ด้วยนะครับห้ามขยับจับนะ"
    },
    {
      "id": 387,
      "start": 915.2,
      "end": 921.28,
      "text": "เพราะว่าถ้าขยับจับแน่นะครับผมฝากไปดู MV"
    },
    {
      "id": 388,
      "start": 918.56,
      "end": 923.6,
      "text": "กันเยอะๆเป็นเพลงที่สนุกๆDanนครับผมก็ใคร"
    },
    {
      "id": 389,
      "start": 921.28,
      "end": 925.64,
      "text": "ที่แบบว่ากำลังเบื่อกำลังเปื่อยอยู่อยาก"
    },
    {
      "id": 390,
      "start": 923.6,
      "end": 928.16,
      "text": "จะบูสบูสก็ฟังเพลงนี้กันได้นะครับ"
    },
    {
      "id": 391,
      "start": 925.64,
      "end": 931.52,
      "text": "น่าจะเป็นเพลงมันอีกเพลงนึงที่อยากให้ทุก"
    },
    {
      "id": 392,
      "start": 928.16,
      "end": 934.2,
      "text": "คนโดดตามกันได้สนุกเต้นกันได้ใน Festival"
    },
    {
      "id": 393,
      "start": 931.52,
      "end": 936.48,
      "text": "แล้วก็ตามคอนต่างๆนะครับผมแล้วก็ Challeng"
    },
    {
      "id": 394,
      "start": 934.2,
      "end": 939.28,
      "text": "ของเพลงนี้ก็ฝากทุกคนไปเล่นด้วยนะฮะ"
    },
    {
      "id": 395,
      "start": 936.48,
      "end": 941.08,
      "text": "เดี๋ยวมีแฟนชาร์จก็เดี๋ยวมาสับๆกันเลย"
    },
    {
      "id": 396,
      "start": 939.28,
      "end": 945.08,
      "text": "ครับเจอกัน"
    },
    {
      "id": 397,
      "start": 941.08,
      "end": 946.6,
      "text": "ห้ามห้ามห้ามขยับ"
    },
    {
      "id": 398,
      "start": 945.08,
      "end": 948.2,
      "text": "้า"
    },
    {
      "id": 399,
      "start": 946.6,
      "end": 951.41,
      "text": "ขยับ"
    },
    {
      "id": 400,
      "start": 948.2,
      "end": 951.41,
      "text": "[เพลง]"
    }
  ]
}