    {
      "id": 255,
      "start": 1031.08,
      "end": 1035.36,
      "text": "เหมือนแบบหนังเนี้ยมันก็จะเป็นหนัง"
    },
    {
      "id": 256,
      "start": 1032.72,
      "end": 1038.84,
      "text": "แอคชั่นที่สู้กันด้วยกล้องเหมือนอันเนี้ย"
    },
    {
      "id": 257,
      "start": 1035.36,
      "end": 1041.28,
      "text": "ลูกปืนหลังจากนั้นมันจะเป็นแบบยำรวมแบบ"
    },
    {
      "id": 258,
      "start": 1038.84,
      "end": 1044.04,
      "text": "ภาพที่ถ่ายกันแล้วก็แบบเออหลบทันบ้างหลบ"
    },
    {
      "id": 259,
      "start": 1041.28,
      "end": 1046.6,
      "text": "ไม่ทันบ้างอะไเงี้ยให้เก๋ๆหลายเรื่องมัน"
    },
    {
      "id": 260,
      "start": 1044.04,
      "end": 1050.36,
      "text": "ก็จะเป็นเหมือนเมื่อกี้ที่สู้กันมาตลอด"
    },
    {
      "id": 261,
      "start": 1046.6,
      "end": 1053.64,
      "text": "เรากลายมาเป็นแบบทุกคนมาเซฟี่ออแต่อ่ะ"
    },
    {
      "id": 262,
      "start": 1050.36,
      "end": 1057.6,
      "text": "สิภาพจบแล้วที่สู้กันมา"
    },
    {
      "id": 263,
