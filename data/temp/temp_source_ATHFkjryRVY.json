      "id": 93,
      "start": 298.76,
      "end": 303.84,
      "text": "แบบเสียงต่ำๆอะไรเงี้ยเหมือนต้องปรับ"
    },
    {
      "id": 94,
      "start": 301.28,
      "end": 306.48,
      "text": "อารมณ์ในแต่ละท่อนแบบไม่เหมือนกันเลยต้อง"
    },
    {
      "id": 95,
      "start": 303.84,
      "end": 310.12,
      "text": "ยืนนิ่งๆครับเหมือนแบบต้องแคติ้งให้มอง"
    },
    {
      "id": 96,
      "start": 306.48,
      "end": 314.6,
      "text": "เหมอครับแล้วก็ร้องไปมันต้องแบบคัดึ๊บ"
    },
    {
      "id": 97,
      "start": 310.12,
      "end": 317.4,
      "text": "เป็นแบบอุ้ยตายวายกีเธอโคตรเท่ตายวีโคตร"
    },
    {
      "id": 98,
      "start": 314.6,
      "end": 319.64,
      "text": "เท่รวมความสร้อยทำไมชีวิตมาเม้น์เหลือแค่"
    },
    {
      "id": 99,
      "start": 317.4,
      "end": 321.4,
      "text": "สกกับเช็ด"
    },
    {
      "id": 100,
      "start": 319.64,
      "end": 323.56,
      "text": "แล้วแล้วจริงๆอ่ะท่อนสุดท้ายคือแต่งมา"
    },
    {
      "id": 101,
      "start": 321.4,
      "end": 326.08,
      "text": "เพื่อนน้องปาล์มเลยให้เรียกอะไรก็ได้ทั้ง"
    },
    {
      "id": 102,
      "start": 323.56,
      "end": 329.36,
      "text": "หมดทั้งที่รักและหมีผมเดินไปบอกปาล์มและ"
    },
    {
      "id": 103,
      "start": 326.08,
      "end": 331.96,
      "text": "ปาล์มสู้ๆนะตอนนี้แหละกินใจมหมีแน่นอนจะ"
    },
    {
      "id": 104,
      "start": 329.36,
      "end": 335.28,
      "text": "ให้ฉันเรียกยังไงก็ยอมทุกอย่างหมดถึงที่"
    },
    {
      "id": 105,
      "start": 331.96,
      "end": 339.36,
      "text": "รักมหาดีนะฟังดี"
    },
    {
      "id": 106,
      "start": 335.28,
      "end": 344.24,
      "text": "นะเจะให้ฉันเรียกยังไงก็ยอมทุกอย่างหมด"
    },
    {
      "id": 107,
      "start": 339.36,
      "end": 349.48,
      "text": "ถึงที่รักมาแมอยากให้เธอได้เข้าใจเหมือน"
    },
    {
      "id": 108,
      "start": 344.24,
      "end": 356.16,
      "text": "แบบว่าใส่ไดนามิเพิ่มได้นะรู้เธอรู้ไหฉัน"
    },
    {
      "id": 109,
      "start": 349.48,
      "end": 360.88,
      "text": "คิดยังไงโอเคนฉันคิดยังไงส่งมีมอยู่ใน"
    },
    {
      "id": 110,
      "start": 356.16,
      "end": 365.56,
      "text": "ช่องคอมเมนต์ไม่รู้เธอรู้ไหมฉันคิดยังไง"
    },
    {
      "id": 111,
      "start": 360.88,
      "end": 369.04,
      "text": "เหลือแค่เพื่อนอะไรทั่วๆไปเที่ยวดีครับมา"
    },
    {
      "id": 112,
      "start": 365.56,
      "end": 372.52,
      "text": "ลองอีกซะกันหวังว่าเธอจะมองอ่านออกฉันไม่"
    },
    {
      "id": 113,
      "start": 369.04,
      "end": 374.76,
      "text": "ได้ยอดีนะดีนะอ้ามาเรื่อยๆเลยมั่นใจมั่น"
    },
    {
      "id": 114,
      "start": 372.52,
      "end": 379.6,
      "text": "ใจได้แล้วตอนนี้"
    },
    {
      "id": 115,
      "start": 374.76,
      "end": 384.24,
      "text": "แต่ว่าคิดจริงจังเฝ้ารอเธอทั้งวันให้เธอ"
    },
    {
      "id": 116,
      "start": 379.6,
      "end": 389.96,
      "text": "นั้นเขามาอ่านแล้วรีบพลหลายตาอ๋อมันต้อง"
    },
    {
      "id": 117,
      "start": 384.24,
      "end": 394.12,
      "text": "ตรงๆได้ครับคิดถึงจังแ่งเฝ้ารอเธอทั้งวัน"
    },
    {
      "id": 118,
      "start": 389.96,
      "end": 398.76,
      "text": "ให้เธอนั้นเข้ามาอ่านและรีพ"
    },
    {
      "id": 119,
      "start": 394.12,
      "end": 404.24,
      "text": "ต่ออีให้มันเข้ามาสวยโรแมนติกกว่านี้โอ"
    },
    {
      "id": 120,
      "start": 398.76,
      "end": 406.96,
      "text": "โอเคครับอยากให้เธอได้เข้าใจถึงความหมาย"
    },
    {
      "id": 121,
      "start": 404.24,
      "end": 406.96,
      "text": "ของทุก"
    },
    {
      "id": 122,
      "start": 407.24,
      "end": 413.6,
      "text": "อย่างเฮ้ยใจใจมันฝ่อไปหน่อยมั้"
    },
    {
      "id": 123,
      "start": 411.6,
      "end": 414.96,
      "text": "เข้าใจ"
    },
    {
      "id": 124,
      "start": 413.6,
      "end": 419.64,
      "text": "ที่ฉันไป"
    },
    {
      "id": 125,
      "start": 414.96,
      "end": 423.04,
      "text": "คอมเมนตมันหยอกๆแท้จริงต้องการจะ"
    },
    {
      "id": 126,
      "start": 419.64,
      "end": 423.04,
      "text": "บอกฉันไป"
    },
    {
      "id": 127,
      "start": 423.56,
      "end": 429.8,
      "text": "คันก็ใครมา"
    },
    {
      "id": 128,
      "start": 427.68,
      "end": 433.56,
      "text": "คือเนี่ยตอนนี้เหลือแค่ตลอดเที่เรารู้สึก"
    },
    {
      "id": 129,
      "start": 429.8,
      "end": 433.56,
      "text": "มันยังฟังไม่ชัดที่ฉันไป"
    },
    {
      "id": 130,
      "start": 435.4,
      "end": 445.6,
      "text": "คอมเมนตยกๆไม่ทันโอเคครับเธอที่ฉันนั้นจะ"
    },
    {
      "id": 131,
      "start": 441.6,
      "end": 446.96,
      "text": "นานพาไปฉันก็มา"
    },
    {
      "id": 132,
      "start": 445.6,
      "end": 449.12,
      "text": "[เพลง]"
    },
    {
      "id": 133,
      "start": 446.96,
      "end": 451.72,
      "text": "อู้อันนี้ก็หาง"
    },
    {
      "id": 134,
      "start": 449.12,
      "end": 458.08,
      "text": "สวยที่ฉัน"
    },
    {
      "id": 135,
      "start": 451.72,
      "end": 461.44,
      "text": "ไปอยากแท้จริงต้องการจะบอกฉันดีเลยอแบบ"
    },
    {
      "id": 136,
      "start": 458.08,
      "end": 461.44,
      "text": "นั้นแบบนั้น"
    },
    {
      "id": 137,
      "start": 462.25,
      "end": 470.68,
      "text": "[เพลง]"
    },
    {
      "id": 138,
      "start": 467.4,
      "end": 473.16,
      "text": "เอ้ยดีๆอันนี้ชารเลิศอยู่นะจริงๆเพลงนี้"
    },
    {
      "id": 139,
      "start": 470.68,
      "end": 474.92,
      "text": "ก็เป็นเพลงที่เรียกได้ว่าแบบเปลี่ยนไว้"
    },
    {
      "id": 140,
      "start": 473.16,
      "end": 477.76,
      "text": "ของพวกเราไปประมาณนึงเลยเพราะว่าเราจะ"
    },
    {
      "id": 141,
      "start": 474.92,
      "end": 480.4,
      "text": "กลับมาสู่ความน่ารักสดใสเข้าถึงง่ายแล้ว"
    },
    {
      "id": 142,
      "start": 477.76,
      "end": 482.76,
      "text": "ก็ฟังได้ทุกเพศทุกวัยนะครับยังไงก็ฝาก"
    },
    {
      "id": 143,
      "start": 480.4,
      "end": 484.56,
      "text": "เพลงนี้ด้วยว่าในอ้อมอกอ้อมใจทุกๆคนนะ"
    },
    {
      "id": 144,
      "start": 482.76,
      "end": 487.4,
      "text": "ครับเพลงนี้เชื่อว่าน่าจะต้องเข้าไปอยู่"
    },
    {
      "id": 145,
      "start": 484.56,
      "end": 490.8,
      "text": "ในหัวใจของคนหลายๆคนได้แน่ๆเลยใช่มั้ครับ"
    },
    {
      "id": 146,
      "start": 487.4,
      "end": 492.84,
      "text": "น้องสาวใช่ครับครับแฮ#ทกซิงสีมาแน่อีกรอบ"
    },
    {
      "id": 147,
      "start": 490.8,
      "end": 499.4,
      "text": "นึงอีกรอบ"
    },
    {
      "id": 148,
      "start": 492.84,
      "end": 499.4,
      "text": "สิ่งที่ฉันนั้นทำออกไปล้วนแล้วมีความ"
    },
    {
      "id": 149,
      "start": 499.8,
      "end": 506.0,
      "text": "ที่ฉันไป"
    },
    {
      "id": 150,
      "start": 501.08,
      "end": 510.4,
      "text": "คอมเมนตมันยากๆเธอจริงต้องการจะบอกว่าฉัน"
    },
    {
      "id": 151,
      "start": 506.0,
      "end": 515.72,
      "text": "คิดถึงเธอตลอดไม่ได้แค่ยอนมาเฝ้าเผอถึง"
    },
    {
      "id": 152,
      "start": 510.4,
      "end": 522.48,
      "text": "แต่เธอที่ฉันคอมเมนตลอดยอกยาวไม่ได้ทำกับ"
    },
    {
      "id": 153,
      "start": 515.72,
      "end": 527.04,
      "text": "ใครมาก่อนเพราะเธอตเธอตเธอฉันคิดจริงฉันน"
    },
    {
      "id": 154,
      "start": 522.48,
      "end": 530.28,
      "text": "เฝ้ารอเธอทั้งวันให้เธอนั้นเข้ามาอ่าน"
    },
    {
      "id": 155,
      "start": 527.04,
      "end": 530.28,
      "text": "แล้วรีบ"
    },
    {
      "id": 156,
      "start": 530.32,
      "end": 536.08,
      "text": "เย้และในที่สุดนะครับเม้นต์ยอกหยอกก็อัด"
    },
    {
      "id": 157,
      "start": 533.04,
      "end": 538.48,
      "text": "เสร็จเป็นที่เรียบร้อยแล้วนะครับ 2 วัน 2"
    },
    {
      "id": 158,
      "start": 536.08,
      "end": 541.48,
      "text": "วันเป็นไงบ้างครับคนอัดวันแรกคือแต่ถือ"
    },
    {
      "id": 159,
      "start": 538.48,
      "end": 544.84,
      "text": "ว่าเท่นะคือท่อนเท่ๆเลยนะพี่อยากแต่งใช่"
    },
    {
      "id": 160,
      "start": 541.48,
      "end": 548.88,
      "text": "ป่ะแต่งมาให้พี่เนเพื่อพี่เนเลยพunchลน"
    },
    {
      "id": 161,
      "start": 544.84,
      "end": 551.64,
      "text": "เลยนะมีน้องปาร์มด้วยนี่หม่าหมีอ่ะมมีก็"
    },
    {
      "id": 162,
      "start": 548.88,
      "end": 555.24,
      "text": "เพื่อปาล์มเลยเดี๋พี่จะเข้าไปฟังพี่จักมา"
    },
    {
      "id": 163,
      "start": 551.64,
      "end": 558.2,
      "text": "บอกว่าพี่ทำท่อนนี้มาให้ปามเท่านั้นปั๊ม"
    },
    