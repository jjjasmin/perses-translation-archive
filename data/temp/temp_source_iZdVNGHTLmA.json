      "id": 102,
      "start": 307.88,
      "end": 314.12,
      "text": "ขึ้นพวกเรากำลังเติบโตขึ้นแล้วก็เติมเต็ม"
    },
    {
      "id": 103,
      "start": 311.6,
      "end": 318.0,
      "text": "ชิ้นส่วนที่ขาดหายของกันและกันก็อยากจะ"
    },
    {
      "id": 104,
      "start": 314.12,
      "end": 321.96,
      "text": "ให้พิเซทุกคนเนี่ยรักแบบนี้ไปตลอดนะครับ"
    },
    {
      "id": 105,
      "start": 318.0,
      "end": 325.76,
      "text": "ผมแล้วก็อยู่ด้วยกันไปนานๆเลยครับ"
    },
    {
      "id": 106,
      "start": 321.96,
      "end": 325.76,
      "text": "1  2  3"
    },
    {
      "id": 107,
      "start": 326.64,
      "end": 334.16,
      "text": "ว"
    },
    {
      "id": 108,
      "start": 329.0,
      "end": 337.24,
      "text": "คนเดียวไงไม่เธอยังไงก็คงไม่เชื่อคนเดียว"
    },
    {
      "id": 109,
      "start": 334.16,
      "end": 339.56,
      "text": "ไงไว้"
    },
    {
      "id": 110,
      "start": 337.24,
      "end": 340.36,
      "text": "โอ้"
    },
    {
      "id": 111,
      "start": 339.56,
      "end": 346.84,
      "text": "อยู่ข้างนี้"
    },
    {
      "id": 112,
      "start": 340.36,
      "end": 351.64,
      "text": "หากไม่มีเธออยู่ข้างกันฉันคงตายอยู่คน"
    },
    {
      "id": 113,
      "start": 346.84,
      "end": 353.56,
      "text": "เดียวไวอยากอยู่กับเธอทุกวันทุกวันทุกวัน"
    },
    {
      "id": 114,
      "start": 351.64,
      "end": 356.12,
      "text": "เรื่อยๆไป"
    },
    {
      "id": 115,
      "start": 353.56,
      "end": 356.68,
      "text": "วันนี้พวกเรามีอะไรมาเซอร์ไพรส์ทุกคนด้วย"
    },
    {
      "id": 116,
      "start": 356.12,
      "end": 358.96,
      "text": "นะครับ"
    },
    {
      "id": 117,
      "start": 356.68,
      "end": 361.8,
      "text": "ว้าว"
    },
    {
      "id": 118,
      "start": 358.96,
      "end": 365.4,
      "text": "พอมครับพรมครับ"
    },
    {
